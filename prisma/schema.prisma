// Rental & Tax Invoicing SaaS - Prisma schema
// Multi-tenant: every business record is scoped by organizationId.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Neon (and most serverless-friendly Postgres hosts) give you a pooled
  // connection string for the app at runtime and a direct one for
  // migrations. DIRECT_URL falls back to DATABASE_URL locally where there
  // is only one connection string.
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Tenancy & Identity
// ---------------------------------------------------------------------------

enum SubscriptionPlan {
  TRIAL
  BASIC
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
}

enum UserRole {
  OWNER
  ADMIN
  MANAGER
  ACCOUNTANT
  VIEWER
}

model Organization {
  id                     String             @id @default(cuid())
  name                   String
  nameAr                 String?
  commercialRegistration String?
  vatNumber              String? // 15-digit Saudi VAT registration number
  country                String             @default("SA")
  // IANA timezone name (Step 23, docs/AUTOMATION-SCHEDULED-JOBS.md "Timezone
  // decision") - every existing organization in this codebase is Saudi-based
  // (country defaults to "SA" above, currency is fixed SAR, ZATCA is
  // Saudi-only), so a safe, explicit V1 default replaces the previously
  // ambiguous server-local-time assumption for scheduled, tenant-facing
  // automation. Validated as a real IANA zone at write time
  // (src/lib/automation/timezone.ts) - never trusted as a free-text string.
  timezone               String             @default("Asia/Riyadh")
  city                   String?
  district               String?
  street                 String?
  buildingNumber         String?
  postalCode             String?
  additionalNumber       String?
  phone                  String?
  email                  String?
  logoUrl                String?
  subscriptionPlan       SubscriptionPlan   @default(TRIAL)
  subscriptionStatus     SubscriptionStatus @default(ACTIVE)
  trialEndsAt            DateTime?
  lastInvoiceHash        String? // ZATCA chain: hash of the most recently issued invoice ("PIH" seed)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  users                          User[]
  properties                     Property[]
  renters                        Renter[]
  contracts                      Contract[]
  invoices                       Invoice[]
  payments                       Payment[]
  counters                       Counter[]
  units                          Unit[]
  compounds                      Compound[]
  buildings                      Building[]
  floors                         Floor[]
  owners                         Owner[]
  propertyOwnerships             PropertyOwnership[]
  ownerLedgerEntries             OwnerLedgerEntry[]
  leads                          Lead[]
  leadActivities                 LeadActivity[]
  viewings                       Viewing[]
  leasingOffers                  LeasingOffer[]
  reservations                   Reservation[]
  moveIns                        MoveIn[]
  moveInInspectionItems          MoveInInspectionItem[]
  moveInInventoryItems           MoveInInventoryItem[]
  moveInMeterReadings            MoveInMeterReading[]
  moveInKeyItems                 MoveInKeyItem[]
  moveInAttachments              MoveInAttachment[]
  maintenanceRequests            MaintenanceRequest[]
  maintenanceWorkOrders          MaintenanceWorkOrder[]
  maintenanceVendors             MaintenanceVendor[]
  moveOuts                       MoveOut[]
  moveOutInspectionItems         MoveOutInspectionItem[]
  moveOutInventoryItems          MoveOutInventoryItem[]
  moveOutMeterReadings           MoveOutMeterReading[]
  moveOutKeyItems                MoveOutKeyItem[]
  moveOutAttachments             MoveOutAttachment[]
  securityDepositSettlements     SecurityDepositSettlement[]
  moveOutLiabilityAssessments    MoveOutLiabilityAssessment[]
  securityDepositLedgerEntries   SecurityDepositLedgerEntry[]
  securityDepositRefunds         SecurityDepositRefund[]
  securityDepositSettlementNotes SecurityDepositSettlementNote[]
  tenantPortalAccounts           TenantPortalAccount[]
  ownerPortalAccounts            OwnerPortalAccount[]
  corporateAccounts              CorporateAccount[]
  corporateContacts              CorporateContact[]
  corporateOccupants             CorporateOccupant[]
  corporateHousingAllocations    CorporateHousingAllocation[]
  communicationTemplates         CommunicationTemplate[]
  communicationRules             CommunicationRule[]
  communicationMessages          CommunicationMessage[]
  communicationDeliveryAttempts  CommunicationDeliveryAttempt[]
  communicationPreferences       CommunicationPreference[]
  documents                      Document[]
  documentVersions               DocumentVersion[]
  documentLinks                  DocumentLink[]
  communicationOutboxEvents      CommunicationOutboxEvent[]
  automationJobs                 AutomationJob[]
  automationSettings             AutomationSettings?

  @@map("organizations")
}

// Atomic per-organization sequence generator (invoice numbers, ICV, contract numbers...)
model Counter {
  id             String       @id @default(cuid())
  organizationId String
  key            String // e.g. "invoice", "contract"
  value          Int          @default(0)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
  @@map("counters")
}

model User {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  email          String
  passwordHash   String
  role           UserRole     @default(VIEWER)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  assignedLeads        Lead[]         @relation("LeadAssignedTo")
  assignedViewings     Viewing[]      @relation("ViewingAssignedTo")
  assignedOffers       LeasingOffer[] @relation("OfferAssignedTo")
  assignedReservations Reservation[]  @relation("ReservationAssignedTo")
  inspectedMoveIns     MoveIn[]       @relation("MoveInInspectedBy")
  handedOverMoveIns    MoveIn[]       @relation("MoveInHandedOverBy")

  reportedMaintenanceRequests   MaintenanceRequest[]    @relation("MaintenanceRequestReportedBy")
  assignedMaintenanceRequests   MaintenanceRequest[]    @relation("MaintenanceRequestAssignedTo")
  triagedMaintenanceRequests    MaintenanceRequest[]    @relation("MaintenanceRequestTriagedBy")
  assignedMaintenanceWorkOrders MaintenanceWorkOrder[]  @relation("MaintenanceWorkOrderAssignedTo")
  verifiedMaintenanceWorkOrders MaintenanceWorkOrder[]  @relation("MaintenanceWorkOrderVerifiedBy")
  maintenanceLaborEntries       MaintenanceLaborEntry[] @relation("MaintenanceLaborEntryUser")

  inspectedMoveOuts        MoveOut[] @relation("MoveOutInspectedBy")
  handedOverMoveOuts       MoveOut[] @relation("MoveOutHandedOverBy")
  findingsReviewedMoveOuts MoveOut[] @relation("MoveOutFindingsReviewedBy")

  reviewedSettlements  SecurityDepositSettlement[]  @relation("SettlementReviewedBy")
  approvedSettlements  SecurityDepositSettlement[]  @relation("SettlementApprovedBy")
  postedSettlements    SecurityDepositSettlement[]  @relation("SettlementPostedBy")
  cancelledSettlements SecurityDepositSettlement[]  @relation("SettlementCancelledBy")
  approvedLiabilities  MoveOutLiabilityAssessment[] @relation("AssessmentApprovedBy")

  managedCorporateAccounts CorporateAccount[] @relation("CorporateAccountManager")

  createdCommunicationTemplates            CommunicationTemplate[] @relation("CommunicationTemplateCreatedBy")
  activatedCommunicationTemplates          CommunicationTemplate[] @relation("CommunicationTemplateActivatedBy")
  createdCommunicationRules                CommunicationRule[]     @relation("CommunicationRuleCreatedBy")
  specificRecipientForRules                CommunicationRule[]     @relation("CommunicationRuleSpecificUser")
  communicationMessagesAsInternalRecipient CommunicationMessage[]  @relation("CommunicationMessageInternalRecipient")
  cancelledCommunicationMessages           CommunicationMessage[]  @relation("CommunicationMessageCancelledBy")

  @@unique([organizationId, email])
  @@index([email])
  @@map("users")
}

// ---------------------------------------------------------------------------
// Property hierarchy: Compound -> Building -> Floor -> Unit
//
// Property/Unit.propertyId are the original (flat) model and are DEPRECATED
// but kept indefinitely for backward compatibility - existing Properties and
// the Units created under them keep working unchanged. Every Unit (old and
// new) has a required `floorId` into the new hierarchy: existing rows were
// backfilled with one generated Compound/Building/Floor per Property at
// migration time. New code should read/write the Compound/Building/Floor
// side; Property/propertyId should be treated as legacy-only.
// See docs/PROPERTY-HIERARCHY.md for the full migration/deprecation plan.
// ---------------------------------------------------------------------------

enum PropertyType {
  RESIDENTIAL
  COMMERCIAL
  MIXED
}

enum UnitType {
  APARTMENT
  VILLA
  OFFICE
  SHOP
  WAREHOUSE
  OTHER
}

enum UnitStatus {
  VACANT
  OCCUPIED
  MAINTENANCE
  RESERVED // held by an active Reservation (PENDING/CONFIRMED) - see docs/RESERVATION-MANAGEMENT.md
}

/// @deprecated superseded by Compound (see docs/PROPERTY-HIERARCHY.md) - kept for backward compatibility, not removed.
model Property {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  nameAr         String?
  propertyType   PropertyType @default(RESIDENTIAL)
  city           String?
  district       String?
  street         String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  units Unit[]

  @@index([organizationId])
  @@map("properties")
}

enum CompoundStatus {
  PLANNING
  UNDER_CONSTRUCTION
  ACTIVE
  INACTIVE
}

model Compound {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  arabicName     String?
  description    String?
  address        String?
  city           String?
  location       String? // free-text location description (e.g. a landmark), distinct from address/city/lat-lng
  latitude       Decimal?       @db.Decimal(10, 7)
  longitude      Decimal?       @db.Decimal(10, 7)
  ownerName      String?
  managerName    String?
  // Denormalized counters, informational only - the app itself always
  // computes live counts (Prisma _count) for dashboards/reports rather than
  // trusting these, to avoid drift if a future integration writes here
  // directly. See docs/PROPERTY-HIERARCHY.md.
  totalBuildings Int            @default(0)
  totalUnits     Int            @default(0)
  amenities      String?
  status         CompoundStatus @default(ACTIVE)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  buildings           Building[]
  propertyOwnerships  PropertyOwnership[]
  ownerLedgerEntries  OwnerLedgerEntry[]
  leads               Lead[]
  maintenanceRequests MaintenanceRequest[]

  @@index([organizationId])
  @@map("compounds")
}

model Building {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  compoundId     String
  compound       Compound     @relation(fields: [compoundId], references: [id], onDelete: Cascade)
  code           String?
  name           String
  // Not in the original field list, but every other bilingual data field in
  // this codebase (Property.nameAr, Renter.fullNameAr, ...) has an Arabic
  // counterpart, and the project's standing rule is that all user-facing
  // data must support both languages - see docs/PROPERTY-HIERARCHY.md.
  nameAr         String?
  description    String?
  numberOfFloors Int?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  floors              Floor[]
  propertyOwnerships  PropertyOwnership[]
  maintenanceRequests MaintenanceRequest[]

  @@index([organizationId])
  @@index([compoundId])
  @@map("buildings")
}

model Floor {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  buildingId     String
  building       Building     @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  floorNumber    Int
  name           String?
  nameAr         String? // see Building.nameAr note above
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  units Unit[]

  @@unique([buildingId, floorNumber])
  @@index([organizationId])
  @@index([buildingId])
  @@map("floors")
}

model Unit {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Legacy flat link - optional now that every unit hangs off `floor`
  // instead. Kept populated for units created before this migration; new
  // units are not required to set it. See docs/PROPERTY-HIERARCHY.md.
  propertyId     String?
  property       Property?    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  // Canonical location going forward: Unit -> Floor -> Building -> Compound.
  floorId        String
  floor          Floor        @relation(fields: [floorId], references: [id])
  unitNumber     String
  floorLabel     String? // free-text floor description (e.g. "3rd Floor"); renamed from the old `floor` scalar column to free that name for the relation above - same data, no loss
  unitType       UnitType     @default(APARTMENT)
  areaSqm        Decimal?     @db.Decimal(10, 2)
  bedrooms       Int?
  bathrooms      Int?
  status         UnitStatus   @default(VACANT)
  baseRentAmount Decimal      @db.Decimal(12, 2)
  vatApplicable  Boolean      @default(false) // residential leasing is VAT-exempt in KSA; commercial is taxable
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  contracts                   Contract[]
  propertyOwnerships          PropertyOwnership[]
  ownerLedgerEntries          OwnerLedgerEntry[]
  viewingUnits                ViewingUnit[]
  leasingOffers               LeasingOffer[]
  reservations                Reservation[]
  moveIns                     MoveIn[]
  maintenanceRequests         MaintenanceRequest[]
  moveOuts                    MoveOut[]
  securityDepositSettlements  SecurityDepositSettlement[]
  corporateHousingAllocations CorporateHousingAllocation[]

  @@index([organizationId])
  @@index([propertyId])
  @@index([floorId])
  // Executive Dashboards (docs/EXECUTIVE-DASHBOARDS.md): supports the
  // Portfolio occupancy snapshot's organizationId+status filter, the same
  // shape getDashboardStats()/getPortfolioSummary() already query.
  @@index([organizationId, status])
  @@map("units")
}

// ---------------------------------------------------------------------------
// Renters (tenants of the properties, i.e. the landlord's customers)
// ---------------------------------------------------------------------------

enum IdType {
  NATIONAL_ID
  IQAMA
  COMMERCIAL_REGISTRATION
  PASSPORT
  GCC_ID
}

model Renter {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fullName       String
  fullNameAr     String?
  idType         IdType       @default(NATIONAL_ID)
  idNumber       String?
  vatNumber      String? // populated for B2B renters -> triggers standard tax invoice
  phone          String?
  email          String?
  address        String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  contracts                  Contract[]
  invoices                   Invoice[]
  payments                   Payment[]
  convertedFromLead          Lead?
  moveIns                    MoveIn[]
  maintenanceRequests        MaintenanceRequest[]
  moveOuts                   MoveOut[]
  securityDepositSettlements SecurityDepositSettlement[]
  tenantPortalAccount        TenantPortalAccount?
  corporateAccount           CorporateAccount?
  communicationMessages      CommunicationMessage[]

  @@index([organizationId])
  @@map("renters")
}

// ---------------------------------------------------------------------------
// Lease contracts & payment schedules
// ---------------------------------------------------------------------------

enum PaymentFrequency {
  MONTHLY
  QUARTERLY
  SEMI_ANNUAL
  ANNUAL
  ONE_TIME
}

enum ContractStatus {
  DRAFT
  ACTIVE
  EXPIRED
  TERMINATED
  RENEWED // superseded by a follow-on contract for the same unit/renter
}

// How the one-off commission/cleaning fees attach to the payment schedule:
// spread evenly across every rent installment, or billed once as its own
// installment due on the contract start date.
enum ExtraChargesMode {
  ONE_TIME
  SPLIT
}

model Contract {
  id               String           @id @default(cuid())
  organizationId   String
  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contractNumber   String
  unitId           String
  unit             Unit             @relation(fields: [unitId], references: [id])
  renterId         String
  renter           Renter           @relation(fields: [renterId], references: [id])
  startDate        DateTime
  endDate          DateTime
  rentAmount       Decimal          @db.Decimal(12, 2)
  paymentFrequency PaymentFrequency @default(ANNUAL)
  securityDeposit  Decimal?         @db.Decimal(12, 2)
  // Rental agency commission and home-cleaning package: both are optional
  // flat fees on top of rent. Unlike rent (which follows vatApplicable/
  // vatRate and can be VAT-exempt for residential leases), these are
  // distinct services and are always taxed at the standard VAT rate.
  commissionAmount Decimal?         @db.Decimal(12, 2)
  cleaningAmount   Decimal?         @db.Decimal(12, 2)
  extraChargesMode ExtraChargesMode @default(ONE_TIME)
  vatApplicable    Boolean          @default(false)
  vatRate          Decimal          @default(15) @db.Decimal(5, 2)
  status           ContractStatus   @default(DRAFT)
  notes            String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  // Renewal chain: set by renewContract() on both sides at once, purely
  // additive (nullable, so every pre-existing contract is simply
  // unlinked). Lets contract history/audit answer "which contract
  // preceded/replaced this one" without inferring it from status alone.
  renewedFromContractId String?   @unique
  renewedFromContract   Contract? @relation("ContractRenewal", fields: [renewedFromContractId], references: [id])
  renewedIntoContract   Contract? @relation("ContractRenewal")

  // Reservation -> Contract conversion traceability (see
  // docs/RESERVATION-TO-CONTRACT.md). Nullable/unique: most contracts are
  // still created manually (source = "Manual"); a Contract created via
  // convertReservationToContract() carries the originating Reservation's
  // id here, and that Reservation's own convertedContractId points back -
  // the unique constraint on both sides is the DB-level backstop against
  // ever creating two Contracts from the same Reservation, on top of the
  // Serializable transaction and the application-layer idempotency check.
  reservationId String?      @unique
  reservation   Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)

  paymentSchedules             PaymentSchedule[]
  invoices                     Invoice[]
  convertedFromLead            Lead?
  // No DB-level unique constraint here (see docs/MOVE-IN-HANDOVER.md,
  // "Contract eligibility") - "one active/completed Move-In per Contract"
  // is enforced the same way "one active Reservation per Offer" already
  // is elsewhere in this schema: an application-layer predicate
  // (blocksNewMoveInForContract()) checked inside a Serializable
  // transaction, not a DB constraint - a Contract may have several
  // CANCELLED MoveIn attempts before a successful one.
  moveIns                      MoveIn[]
  maintenanceRequests          MaintenanceRequest[]
  moveOuts                     MoveOut[]
  securityDepositSettlements   SecurityDepositSettlement[]
  securityDepositLedgerEntries SecurityDepositLedgerEntry[]
  corporateHousingAllocations  CorporateHousingAllocation[]

  @@unique([organizationId, contractNumber])
  @@index([organizationId])
  // Executive Dashboards: supports Active Contracts / Contract Expiry
  // (30/60/90-day) queries, which always filter by organizationId+status
  // and range on endDate (src/lib/executive/leasing.ts).
  @@index([organizationId, status, endDate])
  @@map("contracts")
}

enum ScheduleStatus {
  PENDING
  PARTIALLY_INVOICED // some (but not all) of its components have been invoiced
  INVOICED
  PAID
  PARTIALLY_PAID
  OVERDUE
  CANCELLED
}

model PaymentSchedule {
  id                    String         @id @default(cuid())
  organizationId        String
  contractId            String
  contract              Contract       @relation(fields: [contractId], references: [id], onDelete: Cascade)
  installmentNo         Int
  periodStart           DateTime
  periodEnd             DateTime
  dueDate               DateTime
  rentAmount            Decimal        @default(0) @db.Decimal(12, 2)
  commissionAmount      Decimal        @default(0) @db.Decimal(12, 2)
  cleaningAmount        Decimal        @default(0) @db.Decimal(12, 2)
  securityDepositAmount Decimal        @default(0) @db.Decimal(12, 2)
  amount                Decimal        @db.Decimal(12, 2)
  status                ScheduleStatus @default(PENDING)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  invoiceLines InvoiceLine[]

  @@index([organizationId])
  @@index([contractId])
  @@index([status])
  @@map("payment_schedules")
}

// ---------------------------------------------------------------------------
// Tax invoices (ZATCA-aligned) & payments
// ---------------------------------------------------------------------------

enum InvoiceDocumentType {
  TAX_INVOICE
  CREDIT_NOTE
  DEBIT_NOTE
}

// ZATCA invoice subtype: standard (B2B, cleared) vs simplified (B2C, reported)
enum InvoiceKind {
  STANDARD
  SIMPLIFIED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum ZatcaSubmissionStatus {
  NOT_SUBMITTED
  PENDING
  CLEARED
  REPORTED
  REJECTED
}

model Invoice {
  id                  String                     @id @default(cuid())
  organizationId      String
  organization        Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoiceNumber       String // human readable, e.g. INV-2026-000123
  icv                 Int // Invoice Counter Value: strictly increasing per organization, never reused
  uuid                String                     @unique // ZATCA invoice UUID
  documentType        InvoiceDocumentType        @default(TAX_INVOICE)
  kind                InvoiceKind                @default(SIMPLIFIED)
  contractId          String?
  contract            Contract?                  @relation(fields: [contractId], references: [id])
  renterId            String
  renter              Renter                     @relation(fields: [renterId], references: [id])
  // Reference-only traceability to the Security Deposit Settlement this
  // invoice's "Additional Tenant Amount Due" receivable belongs to, when
  // applicable (Step 32/57) - SetNull, never able to block deleting either
  // side, and Invoice's own issuance/payment/cancellation rules remain
  // completely unchanged and authoritative.
  settlementId        String?
  settlement          SecurityDepositSettlement? @relation(fields: [settlementId], references: [id], onDelete: SetNull)
  issueDate           DateTime                   @default(now())
  supplyDate          DateTime                   @default(now())
  dueDate             DateTime?
  currency            String                     @default("SAR")
  subtotal            Decimal                    @db.Decimal(12, 2)
  vatAmount           Decimal                    @db.Decimal(12, 2)
  totalAmount         Decimal                    @db.Decimal(12, 2)
  paidAmount          Decimal                    @default(0) @db.Decimal(12, 2)
  status              InvoiceStatus              @default(ISSUED)
  previousInvoiceHash String? // PIH: hash of the prior invoice in the chain (base64 SHA-256)
  invoiceHash         String? // hash of this invoice's canonical content (base64 SHA-256)
  qrCodeBase64        String? // ZATCA TLV-encoded QR payload, base64
  zatcaStatus         ZatcaSubmissionStatus      @default(NOT_SUBMITTED)
  zatcaResponse       Json?
  notes               String?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt

  lines    InvoiceLine[]
  payments Payment[]

  @@unique([organizationId, invoiceNumber])
  @@unique([organizationId, icv])
  @@index([organizationId])
  @@index([renterId])
  // Hardening (docs/PERFORMANCE-REVIEW.md, "Dashboard query audit"):
  // supports getDashboardStats()'s monthly invoiced/collected trend, which
  // filters by organizationId + a 6-month issueDate window rather than
  // scanning every invoice the organization has ever issued.
  @@index([organizationId, issueDate])
  // Executive Dashboards: supports Outstanding Receivables' aging query
  // (organizationId+status, ordered/filtered by dueDate -
  // src/lib/executive/collections.ts).
  @@index([organizationId, status, dueDate])
  @@map("invoices")
}

enum InvoiceLineKind {
  RENT
  COMMISSION
  CLEANING
  SECURITY_DEPOSIT
  OTHER
}

model InvoiceLine {
  id                String          @id @default(cuid())
  invoiceId         String
  invoice           Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  // Which schedule installment this line bills, and which component of it -
  // lets one schedule be invoiced across several separate invoices (e.g.
  // rent now, commission later), and lets the schedule's fulfilled status
  // be computed by summing lines per kind. Null for lines not tied to a
  // schedule (shouldn't happen via the current UI, but kept optional for
  // flexibility).
  paymentScheduleId String?
  kind              InvoiceLineKind @default(OTHER)
  description       String
  descriptionAr     String?
  periodStart       DateTime?
  periodEnd         DateTime?
  quantity          Decimal         @default(1) @db.Decimal(10, 2)
  unitPrice         Decimal         @db.Decimal(12, 2)
  discount          Decimal         @default(0) @db.Decimal(12, 2)
  vatRate           Decimal         @default(15) @db.Decimal(5, 2)
  vatAmount         Decimal         @db.Decimal(12, 2)
  lineTotal         Decimal         @db.Decimal(12, 2)

  paymentSchedule PaymentSchedule? @relation(fields: [paymentScheduleId], references: [id])

  @@index([paymentScheduleId])
  @@map("invoice_lines")
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CHEQUE
  CARD
  ONLINE
}

enum PaymentStatus {
  POSTED
  REVERSED
}

/// Payments are never hard-deleted or edited after posting. A correction is
/// made by reversePayment(), which posts a NEW row with a NEGATIVE `amount`
/// (so every existing report/statement that does SUM(amount) nets out
/// correctly with no query changes) and flips the original to `REVERSED` -
/// the original row itself is never touched otherwise. See
/// docs/AUDIT-AND-FINANCIAL-CONTROLS.md, "Payment reversal decision".
model Payment {
  id              String        @id @default(cuid())
  organizationId  String
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoiceId       String
  invoice         Invoice       @relation(fields: [invoiceId], references: [id])
  renterId        String
  renter          Renter        @relation(fields: [renterId], references: [id])
  receiptNumber   String
  amount          Decimal       @db.Decimal(12, 2)
  paymentDate     DateTime      @default(now())
  method          PaymentMethod @default(BANK_TRANSFER)
  referenceNumber String?
  notes           String?
  status          PaymentStatus @default(POSTED)
  createdAt       DateTime      @default(now())

  reversalOfPaymentId String?  @unique
  reversalOfPayment   Payment? @relation("PaymentReversal", fields: [reversalOfPaymentId], references: [id])
  reversedByPayment   Payment? @relation("PaymentReversal")

  @@unique([organizationId, receiptNumber])
  @@index([organizationId])
  @@index([invoiceId])
  @@map("payments")
}

// ---------------------------------------------------------------------------
// Ownership & owner accounting foundation
//
// This is the internal ownership/accounting layer only - there is no owner
// login or self-service portal yet (see docs/OWNERSHIP-ACCOUNTING.md for the
// future Owner Portal design considerations). It is purely additive: no
// existing Contract/Invoice/Payment/PaymentSchedule row or field is touched,
// and no historical financial data is auto-migrated into it. Existing
// compounds/buildings/units may simply have no ownership configured yet.
// ---------------------------------------------------------------------------

enum OwnerType {
  INDIVIDUAL
  COMPANY
  FUND
  GOVERNMENT_ENTITY
  OTHER
}

enum OwnerStatus {
  ACTIVE
  INACTIVE
}

/// An individual, company, investment fund, or government entity that owns
/// (all or part of) a Compound/Building/Unit. Not a User - owners do not log
/// in (no portal yet). Soft-deleted via `deletedAt`; `status` is a separate,
/// reversible "deactivated" flag distinct from deletion.
model Owner {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  ownerType OwnerType @default(INDIVIDUAL)

  name   String
  nameAr String?

  // Identity - only the fields relevant to ownerType are expected to be
  // filled in; none are required at the schema level since which ID applies
  // depends on ownerType (individual vs. company/fund).
  nationalId                String?
  iqamaNumber               String?
  passportNumber            String?
  companyRegistrationNumber String?
  vatNumber                 String?

  email           String?
  mobile          String?
  alternateMobile String?

  address String?
  city    String?
  country String? @default("SA")

  // Banking details - sensitive; not included in list views, only the owner
  // profile/edit screens (see docs/OWNERSHIP-ACCOUNTING.md, "sensitive
  // fields" note).
  bankName        String?
  bankAccountName String?
  iban            String?

  notes  String?
  status OwnerStatus @default(ACTIVE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  // Acting user id at creation/last-update time, for auditability. Not a
  // foreign key on purpose - an audit trail must survive a User being
  // removed in the future, and this codebase has no user-delete flow today
  // anyway, so a hard FK would add constraint risk for no present benefit.
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  ownerships            PropertyOwnership[]
  ledgerEntries         OwnerLedgerEntry[]
  ownerPortalAccount    OwnerPortalAccount?
  communicationMessages CommunicationMessage[]

  @@index([organizationId])
  @@index([organizationId, deletedAt])
  @@map("owners")
}

enum OwnershipStatus {
  ACTIVE
  ENDED
}

/// Assigns an Owner (at a percentage) to exactly one level of the property
/// hierarchy - a Compound, a Building, or a Unit. Deliberately NOT a single
/// ownerId column on Unit: a unit's effective owner(s) are resolved at read
/// time by walking Unit -> Building -> Compound and taking the closest level
/// that has an active ownership record (see getEffectiveOwners() in
/// src/lib/ownership.ts and docs/OWNERSHIP-ACCOUNTING.md, "Ownership
/// inheritance"). This means a compound-wide ownership assignment is never
/// duplicated onto every one of its units.
model PropertyOwnership {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  ownerId String
  owner   Owner  @relation(fields: [ownerId], references: [id])

  // Exactly one of these three should be set per record (enforced in the
  // service layer; a DB-level CHECK constraint requiring at least one is
  // added by the migration as defense in depth - see migration.sql).
  compoundId String?
  compound   Compound? @relation(fields: [compoundId], references: [id], onDelete: Cascade)
  buildingId String?
  building   Building? @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  // Restrict, not Cascade (D-010): a Unit with an ownership assignment
  // carries ownership history that must be preserved even if the Unit was
  // never leased - deleting the Unit must be blocked (same
  // friendly-message path as every other protected relation in
  // deleteUnit(), src/lib/actions/units.ts) rather than silently
  // destroying the ownership record. Compound/Building's own Cascade above
  // are a separate, pre-existing concern out of D-010's scope (Unit
  // deletion only) - see docs/TECHNICAL-DEBT.md.
  unitId String?
  unit   Unit?   @relation(fields: [unitId], references: [id], onDelete: Restrict)

  // 0.00-100.00. The sum of ACTIVE ownershipPercentage values for the exact
  // same asset (same compoundId/buildingId/unitId triple) must never exceed
  // 100 - enforced in src/lib/actions/ownership.ts before every insert.
  ownershipPercentage Decimal @db.Decimal(5, 2)

  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?

  status OwnershipStatus @default(ACTIVE)
  notes  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  @@index([organizationId])
  @@index([ownerId])
  @@index([compoundId])
  @@index([buildingId])
  @@index([unitId])
  @@map("property_ownerships")
}

/// Extensible - see docs/OWNERSHIP-ACCOUNTING.md for the debit/credit
/// convention each type follows (income/contribution = credit,
/// expense/distribution = debit).
enum OwnerLedgerEntryType {
  RENT_INCOME
  OTHER_INCOME
  MANAGEMENT_FEE
  MAINTENANCE_EXPENSE
  UTILITY_EXPENSE
  SERVICE_EXPENSE
  GOVERNMENT_FEE
  OTHER_EXPENSE
  OWNER_CONTRIBUTION
  OWNER_DISTRIBUTION
  ADJUSTMENT
  REVERSAL
}

/// Immutable append-only ledger: there is deliberately no update/delete
/// server action for this model anywhere in the codebase. A posted entry is
/// corrected only by posting a REVERSAL entry that mirrors it (debit/credit
/// swapped) via reverseLedgerEntry() - see src/lib/actions/owner-ledger.ts.
model OwnerLedgerEntry {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  ownerId String
  owner   Owner  @relation(fields: [ownerId], references: [id])

  entryType OwnerLedgerEntryType

  // Free-text pointer to what generated this entry (e.g. "MANUAL",
  // "ALLOCATION"), not a Prisma relation - this ledger must stay postable
  // even for sources that aren't (yet) their own model, and must never be
  // able to cascade-delete a financial record.
  referenceType String?
  referenceId   String?

  description   String
  descriptionAr String?

  debit  Decimal @default(0) @db.Decimal(12, 2)
  credit Decimal @default(0) @db.Decimal(12, 2)

  entryDate DateTime @default(now())

  compoundId String?
  compound   Compound? @relation(fields: [compoundId], references: [id])
  // Restrict, not the SetNull default (D-010): a ledger entry tagging a
  // Unit is a financial record referencing that Unit for reporting/audit
  // purposes - silently detaching it on Unit deletion would let a
  // financial record survive with its unit traceability quietly erased.
  // Same "must not silently destroy financial records" principle as
  // deleteUnit()'s other protected relations.
  unitId String?
  unit   Unit?   @relation(fields: [unitId], references: [id], onDelete: Restrict)

  // Reversal linkage: set on the REVERSAL entry (points back at what it
  // reverses) and on the original entry (points forward, so it can't be
  // reversed twice). Both unique - a one-to-one pairing.
  reversalOfEntryId String?           @unique
  reversalOfEntry   OwnerLedgerEntry? @relation("LedgerReversal", fields: [reversalOfEntryId], references: [id])
  reversedByEntry   OwnerLedgerEntry? @relation("LedgerReversal")

  createdBy String?
  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([ownerId])
  @@index([entryDate])
  @@map("owner_ledger_entries")
}

// ---------------------------------------------------------------------------
// Audit log
//
// Immutable, append-only, system-written-only record of every mutating
// action across the app. No update/delete server action exists for this
// model anywhere in the codebase, and there is deliberately no `updatedAt`
// or `deletedAt` column - a row is written once and never touched again.
// See docs/AUDIT-AND-FINANCIAL-CONTROLS.md.
//
// organizationId/userId/userEmail/userRole are plain denormalized fields,
// NOT Prisma relations - on purpose, mirroring Owner.createdBy/updatedBy in
// this schema: an audit trail must remain queryable and intact even if the
// Organization or User it refers to is later deleted, renamed, or has its
// role changed. `action`/`entityType` are plain strings (not Prisma enums)
// so a new audited action never requires a schema migration - type safety
// for both is enforced at the application layer instead, in src/lib/audit.ts.
// ---------------------------------------------------------------------------

model AuditLog {
  id             String @id @default(cuid())
  organizationId String

  userId    String?
  userEmail String?
  userRole  String?

  action String

  entityType String
  entityId   String

  entityDisplayName String?

  // Only the fields that actually changed (for UPDATE), or the relevant
  // created/deleted state (for CREATE/DELETE) - never a full raw row dump.
  // Redacted per src/lib/audit.ts's REDACTED_FIELDS/MASKED_FIELDS before
  // being written; see docs/AUDIT-AND-FINANCIAL-CONTROLS.md, "Redaction".
  previousValues Json?
  newValues      Json?

  // Free-form extra context (e.g. { reason, denialReason, attemptedEmail }) -
  // used by permission-denial and login events, which have no entity row.
  metadata Json?

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([organizationId, entityType, entityId])
  @@index([organizationId, action])
  @@index([userId])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// CRM: Leads
//
// A Lead is a prospective residential/corporate tenant BEFORE a lease
// exists - it deliberately does not reuse or extend the `Renter` model
// (Renter is a contracted tenancy entity used throughout invoicing/
// payments/statements). A Lead becomes a Renter only through the explicit
// convertLeadToRenter() workflow (see docs/CRM-LEADS.md); the Lead row is
// never deleted by conversion, only linked via `convertedRenterId` and
// moved to WON, so its full pipeline history stays intact.
//
// This is the Lead + Qualification + pipeline foundation only - Viewings,
// Offers, Reservations, and automatic Contract creation are a future task
// (see docs/CRM-LEADS.md, "Future Viewing/Offer/Reservation architecture").
// ---------------------------------------------------------------------------

enum LeadType {
  INDIVIDUAL
  CORPORATE
  AGENT_REFERRAL
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  VIEWING_PENDING // reserved for the future Viewing module - not settable by any action in this task
  VIEWING_COMPLETED // reserved for the future Viewing module - not settable by any action in this task
  OFFER_PENDING // reserved for the future Offer module - not settable by any action in this task
  NEGOTIATION // reserved for the future Offer module - not settable by any action in this task
  RESERVATION_PENDING // reserved for the future Reservation module - not settable by any action in this task
  WON
  LOST
  ARCHIVED
}

enum LeadSource {
  FACEBOOK
  INSTAGRAM
  GOOGLE
  WHATSAPP
  WEBSITE
  REFERRAL
  WALK_IN
  CORPORATE
  AGENT
  PHONE
  OTHER
}

enum FurnishingPreference {
  FURNISHED
  SEMI_FURNISHED
  UNFURNISHED
  FLEXIBLE
}

enum LeadLostReason {
  PRICE
  NO_AVAILABILITY
  LOCATION
  COMPETITOR
  NO_RESPONSE
  BUDGET
  TIMING
  CUSTOMER_CANCELLED
  OTHER
}

enum LeadActivityType {
  CALL
  WHATSAPP
  EMAIL
  MEETING
  NOTE
  FOLLOW_UP
  STATUS_CHANGE
  OTHER
}

model Lead {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  leadNumber String // e.g. "LEAD-000001" - sequential per organization via the existing Counter infrastructure (key "lead"), never a separate numbering scheme

  leadType LeadType   @default(INDIVIDUAL)
  status   LeadStatus @default(NEW)

  // Individual/agent-referral contact identity. For CORPORATE leads these
  // hold the case contact's name (mirrored into contactPerson* below for
  // clarity); `fullName` is always kept in sync (by the server action, not
  // a DB trigger) as the single display name used across list/search UI -
  // "first last" for individuals, `companyName` for corporate leads.
  firstName String?
  lastName  String?
  fullName  String

  mobile           String
  // Normalized (digits only, country-code-canonicalized) form of `mobile`,
  // computed by src/lib/crm/phone.ts at write time - used for duplicate
  // detection and the organizationId+normalizedMobile index. `mobile`
  // itself keeps the original, user-entered display value.
  normalizedMobile String
  alternateMobile  String?
  email            String?

  nationality String?

  employer String?
  jobTitle String?

  // Also used as the primary company identity for CORPORATE leads.
  companyName String?

  // CORPORATE-only fields (see docs/CRM-LEADS.md, "Corporate leads") - this
  // is deliberately NOT a separate Corporate Client model yet, just the
  // additional fields a corporate housing enquiry needs on the Lead itself.
  contactPersonName   String?
  contactPersonMobile String?
  contactPersonEmail  String?
  employeeCount       Int?
  requiredUnits       Int?
  requestedCity       String?
  projectName         String?
  housingStartDate    DateTime?
  housingEndDate      DateTime?

  familySize Int?

  budgetMin Decimal? @db.Decimal(12, 2)
  budgetMax Decimal? @db.Decimal(12, 2)

  preferredBedrooms Int?
  // Reuses the existing UnitType enum (see Unit model) rather than a new
  // CRM-specific one - a lead's unit-type preference and a real unit's
  // type are the same concept.
  preferredUnitType UnitType?

  preferredCompoundId String?
  preferredCompound   Compound? @relation(fields: [preferredCompoundId], references: [id], onDelete: SetNull)

  moveInDate          DateTime?
  leaseDurationMonths Int?
  furnishedPreference FurnishingPreference?

  notes String?

  source LeadSource @default(OTHER)

  // Live operational assignment (unlike createdByUserId below, this is a
  // real relation: the UI needs to join/display/reassign it, and it must
  // be verified to belong to the same organization on every write).
  assignedToUserId String?
  assignedToUser   User?   @relation("LeadAssignedTo", fields: [assignedToUserId], references: [id], onDelete: SetNull)

  // Plain string, not a relation - mirrors Owner.createdBy/updatedBy: an
  // audit-adjacent attribution field that must survive a User being
  // removed, not a live join target.
  createdByUserId String

  convertedRenterId String? @unique
  convertedRenter   Renter? @relation(fields: [convertedRenterId], references: [id], onDelete: SetNull)

  // Reserved for the future Contract-conversion step (not implemented in
  // this task) - present now so the column exists additively rather than
  // requiring another migration when that workflow is built.
  convertedContractId String?   @unique
  convertedContract   Contract? @relation(fields: [convertedContractId], references: [id], onDelete: SetNull)

  lostReason     LeadLostReason?
  lostReasonNote String?

  lastContactAt  DateTime?
  nextFollowUpAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activities    LeadActivity[]
  viewings      Viewing[]
  leasingOffers LeasingOffer[]
  reservations  Reservation[]

  @@unique([organizationId, leadNumber])
  @@index([organizationId, status])
  @@index([organizationId, normalizedMobile])
  @@index([organizationId, assignedToUserId])
  @@index([organizationId, nextFollowUpAt])
  @@index([organizationId, source])
  @@index([organizationId, createdAt])
  @@map("leads")
}

/// Business interaction history (calls, WhatsApp, meetings, notes, follow-
/// ups) - append-only by convention (no update/delete action exists), but
/// distinct from AuditLog: LeadActivity is what leasing staff did with a
/// prospect, AuditLog is the system/security record of what changed and
/// who has access. See docs/CRM-LEADS.md, "LeadActivity vs AuditLog".
model LeadActivity {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leadId         String
  lead           Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)

  activityType LeadActivityType

  subject String?
  notes   String?

  activityDate DateTime @default(now())

  // Plain string (never client-supplied - see src/lib/actions/lead-
  // activities.ts) - same attribution pattern as Lead.createdByUserId.
  createdByUserId String
  createdAt       DateTime @default(now())

  @@index([organizationId, leadId])
  @@index([organizationId, activityDate])
  @@map("lead_activities")
}

// ---------------------------------------------------------------------------
// CRM: Viewing Management
//
// A Viewing is a scheduled visit by a Lead to one or more Units. This is
// purely additive on top of the Lead/LeadActivity/Unit models - none of
// them are redesigned. Scope is deliberately Viewing-only: the future
// Offer/Reservation steps (Lead -> Viewing -> Offer -> Reservation ->
// Contract) are not implemented here - see docs/VIEWING-MANAGEMENT.md,
// "Future Offer/Reservation integration".
// ---------------------------------------------------------------------------

enum ViewingStatus {
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
  RESCHEDULED // transient: set briefly by rescheduleViewing() and immediately moved back to SCHEDULED/CONFIRMED in the same transaction - see docs/VIEWING-MANAGEMENT.md, "Rescheduling"
}

enum ViewingOutcome {
  INTERESTED
  FOLLOW_UP_REQUIRED
  NOT_INTERESTED
  OFFER_REQUESTED
  RESERVATION_REQUESTED
  OTHER
}

enum ViewingCancelReason {
  CUSTOMER_REQUEST
  AGENT_UNAVAILABLE
  UNIT_UNAVAILABLE
  RESCHEDULED
  NO_RESPONSE
  OTHER
}

model Viewing {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  viewingNumber String // e.g. "VIEW-000001" - sequential per organization via the existing Counter infrastructure (key "viewing"), never a separate numbering scheme

  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  // Live operational assignment - same pattern as Lead.assignedToUserId:
  // a real relation (not a plain string), verified same-organization on
  // every write, since the UI joins/displays/reassigns it constantly.
  assignedToUserId String?
  assignedToUser   User?   @relation("ViewingAssignedTo", fields: [assignedToUserId], references: [id], onDelete: SetNull)

  scheduledStart DateTime
  scheduledEnd   DateTime

  status ViewingStatus @default(SCHEDULED)

  customerNotes String?
  internalNotes String?

  feedbackSummary String?
  outcome         ViewingOutcome?

  cancelReason     ViewingCancelReason?
  cancelReasonNote String?

  completedAt DateTime?

  // Plain string, not a relation - mirrors Lead.createdByUserId: survives
  // a User being removed, not a live join target.
  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  units         ViewingUnit[]
  leasingOffers LeasingOffer[]

  @@unique([organizationId, viewingNumber])
  @@index([organizationId, scheduledStart])
  @@index([organizationId, assignedToUserId, scheduledStart])
  @@index([organizationId, leadId])
  @@index([organizationId, status])
  @@map("viewings")
}

/// Join table: a Viewing may cover more than one Unit (e.g. touring two
/// comparable apartments back-to-back). Deliberately thin - no Unit data
/// is duplicated here, only the linkage plus per-unit sequence/notes.
model ViewingUnit {
  id             String @id @default(cuid())
  organizationId String

  viewingId String
  viewing   Viewing @relation(fields: [viewingId], references: [id], onDelete: Cascade)

  unitId String
  unit   Unit   @relation(fields: [unitId], references: [id])

  sequence Int     @default(1)
  notes    String?

  createdAt DateTime @default(now())

  @@unique([viewingId, unitId])
  @@index([organizationId, unitId])
  @@map("viewing_units")
}

// ---------------------------------------------------------------------------
// CRM: Leasing Offer Management
//
// A LeasingOffer is a commercial pre-contract proposal: Lead -> (optional)
// Viewing -> Offer -> Negotiation -> future Reservation -> future Contract.
// Purely additive on top of Lead/Viewing/Unit - none of them are redesigned,
// and this task deliberately stops short of Reservations/Contract
// conversion - see docs/LEASING-OFFERS.md, "Future Reservation/Contract
// integration". Offer calculations are commercial/pre-contract data only:
// no Invoice/PaymentSchedule/Payment/OwnerLedgerEntry row is ever created by
// any action in this file.
// ---------------------------------------------------------------------------

enum OfferStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SENT
  UNDER_NEGOTIATION
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
  SUPERSEDED // superseded by a newer revision in the same offerNumber chain - see reviseOffer()
}

/// Deliberately separate from OfferStatus (Step 12 of the brief): internal
/// discount-approval sign-off and the customer's own accept/reject decision
/// are different concepts and must never be conflated in one enum. See
/// docs/LEASING-OFFERS.md, "Approval rules".
enum ApprovalStatus {
  NOT_REQUIRED
  PENDING
  APPROVED
  REJECTED
}

/// The customer's own reason for declining an offer - distinct from
/// LeadLostReason (a Lead can be rejected on this Offer without ever being
/// marked LOST, see docs/LEASING-OFFERS.md, "Lead status integration").
enum OfferRejectReason {
  PRICE
  PAYMENT_TERMS
  UNIT
  LOCATION
  TIMING
  COMPETITOR
  CUSTOMER_CANCELLED
  OTHER
}

model LeasingOffer {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Stable across an entire revision chain (Step 11) - e.g. "OFFER-000001"
  // via the existing Counter infrastructure (key "offer"), allocated only
  // once per chain (on the first version); revisions copy it rather than
  // drawing a new sequence value. `versionNumber` is the only thing that
  // increments per revision - see reviseOffer() in src/lib/actions/offers.ts.
  offerNumber   String
  versionNumber Int    @default(1)

  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  // Optional - Step 10 requires a direct Offer from a qualified Lead to
  // remain possible without ever having gone through a Viewing.
  viewingId String?
  viewing   Viewing? @relation(fields: [viewingId], references: [id], onDelete: SetNull)

  // Single primary Unit only (Step 3) - schema is additive-friendly for a
  // future OfferUnit join table (corporate multi-unit), not implemented here.
  unitId String
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Restrict)

  status         OfferStatus    @default(DRAFT)
  approvalStatus ApprovalStatus @default(NOT_REQUIRED)

  validFrom  DateTime
  validUntil DateTime

  currency String @default("SAR")

  // Pricing - see src/lib/crm/offer-pricing.ts for the pure calculation
  // this row's stored values are derived from. Rent itself carries no VAT
  // at Offer stage (matching Contract.vatApplicable defaulting to false for
  // residential leasing); only the leasing commission is taxed, mirroring
  // EXTRA_CHARGE_VAT_RATE in src/lib/actions/invoices.ts.
  annualRent         Decimal @db.Decimal(12, 2)
  discountAmount     Decimal @default(0) @db.Decimal(12, 2)
  discountPercentage Decimal @default(0) @db.Decimal(5, 2)
  netAnnualRent      Decimal @db.Decimal(12, 2)

  securityDeposit Decimal @db.Decimal(12, 2)
  contractFee     Decimal @default(0) @db.Decimal(12, 2)

  leasingCommissionAmount Decimal  @default(0) @db.Decimal(12, 2)
  leasingCommissionRate   Decimal? @db.Decimal(5, 2)
  commissionVatRate       Decimal  @default(15) @db.Decimal(5, 2)
  commissionVatAmount     Decimal  @default(0) @db.Decimal(12, 2)

  totalInitialPayment Decimal @db.Decimal(12, 2)

  paymentFrequency PaymentFrequency @default(ANNUAL)

  leaseStartDate      DateTime?
  leaseDurationMonths Int       @default(12)

  furnishedStatus FurnishingPreference @default(UNFURNISHED)

  specialTerms  String?
  internalNotes String?

  sentAt     DateTime?
  acceptedAt DateTime?
  rejectedAt DateTime?
  expiredAt  DateTime?

  rejectReason     OfferRejectReason?
  rejectReasonNote String?

  // Plain string, not a relation - mirrors Lead.createdByUserId/
  // Viewing.createdByUserId: survives a User being removed.
  createdByUserId String

  // Live operational assignment - same pattern as Lead/Viewing's
  // assignedToUserId: a real relation, verified same-organization on every
  // write.
  assignedToUserId String?
  assignedToUser   User?   @relation("OfferAssignedTo", fields: [assignedToUserId], references: [id], onDelete: SetNull)

  // Revision chain (Step 11/32): unique so exactly one child can ever point
  // at a given parent, keeping the chain linear - mirrors
  // Contract.renewedFromContractId. Set only by reviseOffer(), which also
  // flips the parent's status to SUPERSEDED in the same transaction.
  parentOfferId String?       @unique
  parentOffer   LeasingOffer? @relation("OfferRevision", fields: [parentOfferId], references: [id], onDelete: SetNull)
  revisedInto   LeasingOffer? @relation("OfferRevision")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reservations Reservation[]

  @@unique([organizationId, offerNumber, versionNumber])
  @@index([organizationId, status])
  @@index([organizationId, leadId])
  @@index([organizationId, unitId])
  @@index([organizationId, assignedToUserId])
  @@index([organizationId, validUntil])
  @@index([organizationId, createdAt])
  @@index([organizationId, offerNumber])
  @@map("leasing_offers")
}

// ---------------------------------------------------------------------------
// CRM: Reservation Management
//
// A Reservation holds a Unit for a prospective tenant after an ACCEPTED
// LeasingOffer and before lease Contract creation. Purely additive on top
// of Lead/LeasingOffer/Unit - none of them are redesigned, and this task
// deliberately stops short of Contract conversion - see
// docs/RESERVATION-MANAGEMENT.md, "Future Contract conversion". No Invoice/
// Payment/PaymentSchedule/OwnerLedgerEntry row is ever created by any
// action in this file - reservationAmount is operational tracking only.
// ---------------------------------------------------------------------------

enum ReservationStatus {
  DRAFT
  PENDING
  CONFIRMED
  EXPIRED
  CANCELLED
  RELEASED
  CONVERTED_TO_CONTRACT // reserved for the future Contract module - not settable by any action in this task
}

enum ReservationAmountStatus {
  NOT_REQUIRED
  PENDING
  RECEIVED
  REFUNDED
  FORFEITED
}

/// The management/customer's own reason for cancelling a reservation -
/// distinct from OfferRejectReason/ViewingCancelReason (different stage,
/// different vocabulary - e.g. PAYMENT_NOT_RECEIVED only makes sense here).
enum ReservationCancelReason {
  CUSTOMER_REQUEST
  PAYMENT_NOT_RECEIVED
  DOCUMENTS_INCOMPLETE
  UNIT_CHANGED
  OFFER_CHANGED
  TIMEOUT
  MANAGEMENT_DECISION
  OTHER
}

model Reservation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // "RES-000001" via the existing Counter infrastructure (key
  // "reservation"), never a separate numbering scheme.
  reservationNumber String

  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  // Required - a Reservation always traces back to the ACCEPTED Offer it
  // was created from (Step 5). Offers are never deleted (no offer.delete
  // action exists), so Restrict is a safety net, not a practical concern.
  offerId String
  offer   LeasingOffer @relation(fields: [offerId], references: [id], onDelete: Restrict)

  // Copied from the Offer at creation time and never allowed to diverge
  // (Step 13: "Do not allow user to change Lead/Unit away from the
  // selected Offer") - kept as its own column (not derived via the Offer
  // relation on every read) because Unit-level conflict/hold queries need
  // to filter directly on it.
  unitId String
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Restrict)

  status ReservationStatus @default(DRAFT)

  reservedAt  DateTime  @default(now())
  holdUntil   DateTime
  confirmedAt DateTime?
  cancelledAt DateTime?
  expiredAt   DateTime?
  releasedAt  DateTime?

  // Set only by convertReservationToContract() (see
  // docs/RESERVATION-TO-CONTRACT.md) in the same transaction that flips
  // status to CONVERTED_TO_CONTRACT. Deliberately a single physical
  // relation, not two duplicated FK columns (Step 13 of the brief): the
  // real foreign key lives on Contract.reservationId (nullable, unique) -
  // `convertedContract` here is Prisma's virtual back-relation, giving
  // "which Contract resulted from this Reservation" for free from the
  // same column that already answers "which Reservation created this
  // Contract" (Contract.reservation). The unique constraint on
  // Contract.reservationId is what actually stops the DB from ever
  // linking a second Contract to the same Reservation.
  convertedContract Contract?
  convertedAt       DateTime?

  reservationAmount       Decimal                 @default(0) @db.Decimal(12, 2)
  reservationAmountStatus ReservationAmountStatus @default(NOT_REQUIRED)

  notes         String?
  internalNotes String?

  cancelReason     ReservationCancelReason?
  cancelReasonNote String?

  // Plain string, not a relation - mirrors Lead/Viewing/Offer's own
  // createdByUserId: survives a User being removed.
  createdByUserId String

  // Live operational assignment - same pattern as Lead/Viewing/Offer's
  // assignedToUserId: a real relation, verified same-organization on every
  // write.
  assignedToUserId String?
  assignedToUser   User?   @relation("ReservationAssignedTo", fields: [assignedToUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, reservationNumber])
  @@index([organizationId, status])
  @@index([organizationId, unitId, status])
  @@index([organizationId, offerId])
  @@index([organizationId, leadId])
  @@index([organizationId, assignedToUserId])
  @@index([organizationId, holdUntil])
  @@index([organizationId, createdAt])
  @@map("reservations")
}

// ---------------------------------------------------------------------------
// Move-In & Handover Inspection (see docs/MOVE-IN-HANDOVER.md)
//
// Establishes the immutable-once-COMPLETED baseline of a Unit's condition at
// delivery to the tenant - the record a future Move-Out module will compare
// against. Purely operational: never creates/alters Invoice/Payment/
// PaymentSchedule/OwnerLedgerEntry, and never changes Unit.status (occupancy
// is already set at Contract creation - see Contract.moveIns above and
// docs/MOVE-IN-HANDOVER.md, "Unit occupancy decision").
// ---------------------------------------------------------------------------

enum MoveInStatus {
  DRAFT
  SCHEDULED
  IN_PROGRESS
  READY_FOR_HANDOVER
  COMPLETED
  CANCELLED
}

enum MoveInCancelReason {
  CONTRACT_CANCELLED
  CUSTOMER_REQUEST
  UNIT_NOT_READY
  RESCHEDULED
  DATA_ERROR
  OTHER
}

/// Shared by MoveIn.overallCondition, MoveInInspectionItem.condition, and
/// MoveInInventoryItem.condition (Step 11: "do not create slightly
/// different condition systems... unless justified" - none of these three
/// uses needs a different vocabulary).
enum ConditionRating {
  NEW
  EXCELLENT
  GOOD
  FAIR
  POOR
  DAMAGED
  NOT_WORKING
  NOT_APPLICABLE
}

/// Shared by MoveInInspectionItem.category and MoveInInventoryItem.category -
/// an inventory item's location ("Bedroom", "Kitchen") is the same set of
/// physical areas an inspection item's category already names, so one enum
/// covers both rather than two parallel category systems.
enum InspectionCategory {
  ENTRANCE
  LIVING_ROOM
  DINING_ROOM
  KITCHEN
  BEDROOM
  BATHROOM
  BALCONY
  WINDOWS_DOORS
  FLOORING
  WALLS_CEILINGS
  LIGHTING
  ELECTRICAL
  PLUMBING
  AIR_CONDITIONING
  APPLIANCES
  FURNITURE
  SAFETY
  OTHER
}

enum MeterType {
  ELECTRICITY
  WATER
  GAS
  OTHER
}

enum KeyType {
  KEY
  ACCESS_CARD
  REMOTE
  PARKING_REMOTE
  OTHER
}

enum MoveInAttachmentType {
  PHOTO
  DOCUMENT
  OTHER
}

model MoveIn {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // "MI-000001" via the existing Counter infrastructure (key "moveIn"),
  // never a separate numbering scheme.
  moveInNumber String

  // Required - a Move-In always traces back to one ACTIVE Contract (Step
  // 7). unitId/renterId below are copied from the Contract at creation and
  // never allowed to diverge (Step 50: "MoveIn Unit/Renter must derive
  // from Contract") - kept as their own columns (not derived via the
  // Contract relation on every read) purely for direct-filter query
  // convenience, same pattern Reservation.unitId already established.
  contractId String
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Restrict)
  unitId     String
  unit       Unit     @relation(fields: [unitId], references: [id], onDelete: Restrict)
  renterId   String
  renter     Renter   @relation(fields: [renterId], references: [id], onDelete: Restrict)

  status MoveInStatus @default(DRAFT)

  scheduledAt  DateTime?
  startedAt    DateTime?
  completedAt  DateTime?
  handoverDate DateTime?

  // Live operational assignment - same pattern as Lead/Viewing/Offer/
  // Reservation's own assignedToUserId: a real relation, verified
  // same-organization on every write.
  inspectedByUserId  String?
  inspectedByUser    User?   @relation("MoveInInspectedBy", fields: [inspectedByUserId], references: [id], onDelete: SetNull)
  handedOverByUserId String?
  handedOverByUser   User?   @relation("MoveInHandedOverBy", fields: [handedOverByUserId], references: [id], onDelete: SetNull)

  // Free-text tenant-representative identity captured at handover - not a
  // User/Renter relation (the person physically present may be the tenant
  // or an authorized representative, and is never an app user).
  tenantRepresentativeName String?
  tenantRepresentativeId   String? // ID/Iqama document number, free text

  overallCondition ConditionRating?

  tenantComments String?
  internalNotes  String?

  // Operational acknowledgement (Step 21) - deliberately NOT a legal
  // e-signature. `tenantAcknowledgementOverride` lets authorized staff
  // complete a handover without a tenant acknowledgement timestamp (Step
  // 22: "tenant acknowledgement OR authorized override"), always paired
  // with a reason and gated by the same moveIn.complete permission as
  // completion itself.
  tenantAcknowledgedAt                DateTime?
  tenantAcknowledgementOverride       Boolean   @default(false)
  tenantAcknowledgementOverrideReason String?
  staffAcknowledgedAt                 DateTime?

  // Operational flag only (Step 23) - defaulted from the originating
  // Offer's furnishedStatus when the Contract came from a Reservation
  // conversion (Contract.reservation.offer.furnishedStatus), staff-
  // editable at creation for manual contracts where no such signal
  // exists. Not a new Unit/Contract-level furnishing source of truth -
  // scoped to this Move-In record only. Drives whether the completion
  // validator requires at least one inventory item (Step 23).
  isFurnished Boolean @default(false)

  // Simple operational readiness confirmations (Step 34) - never a
  // Maintenance Work Order.
  utilitiesReady   Boolean @default(false)
  keysReady        Boolean @default(false)
  cleaningComplete Boolean @default(false)
  unitReady        Boolean @default(false)

  // Set true only when staff explicitly confirms there are no keys/access
  // items to record (Step 22's "recorded or explicitly marked none") -
  // otherwise the completion validator requires at least one MoveInKeyItem.
  noKeysToRecord Boolean @default(false)

  cancelReason     MoveInCancelReason?
  cancelReasonNote String?
  cancelledAt      DateTime?

  // Plain string, not a relation - mirrors every other CRM module's own
  // createdByUserId: survives a User being removed.
  createdByUserId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inspectionItems     MoveInInspectionItem[]
  inventoryItems      MoveInInventoryItem[]
  meterReadings       MoveInMeterReading[]
  keyItems            MoveInKeyItem[]
  attachments         MoveInAttachment[]
  maintenanceRequests MaintenanceRequest[]
  moveOuts            MoveOut[]

  @@unique([organizationId, moveInNumber])
  @@index([organizationId, status])
  @@index([organizationId, contractId])
  @@index([organizationId, unitId])
  @@index([organizationId, renterId])
  @@index([organizationId, scheduledAt])
  @@index([organizationId, handoverDate])
  @@map("move_ins")
}

model MoveInInspectionItem {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  moveInId       String
  moveIn         MoveIn       @relation(fields: [moveInId], references: [id], onDelete: Cascade)

  category InspectionCategory

  itemName   String
  itemNameAr String?

  // Null until inspected - isItemComplete()/computeInspectionProgress() in
  // src/lib/operations/move-in-rules.ts are the single source of truth for
  // what "complete" means, never re-derived ad hoc elsewhere.
  condition ConditionRating?

  // False for an item the default template includes but this specific
  // Unit doesn't have (Step 9: "do not assume every Unit has every area") -
  // excluded from the progress denominator entirely, same as an item whose
  // condition is separately set to NOT_APPLICABLE.
  isApplicable Boolean @default(true)

  notes             String?
  requiresAttention Boolean @default(false)

  // Display/entry order within its category - set from the default
  // template's own ordering at creation (Step 12).
  sequence Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attachments            MoveInAttachment[]
  maintenanceRequests    MaintenanceRequest[]
  moveOutInspectionItems MoveOutInspectionItem[]

  @@index([organizationId, moveInId])
  @@index([moveInId, category])
  @@map("move_in_inspection_items")
}

model MoveInInventoryItem {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  moveInId       String
  moveIn         MoveIn       @relation(fields: [moveInId], references: [id], onDelete: Cascade)

  // Reuses InspectionCategory (see enum comment) rather than a second
  // furniture-specific category enum.
  category InspectionCategory
  itemName String

  quantity Int @default(1)

  condition ConditionRating?

  serialNumber String?
  brand        String?
  model        String?
  notes        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attachments MoveInAttachment[]

  @@index([organizationId, moveInId])
  @@map("move_in_inventory_items")
}

model MoveInMeterReading {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  moveInId       String
  moveIn         MoveIn       @relation(fields: [moveInId], references: [id], onDelete: Cascade)

  meterType     MeterType
  meterNumber   String?
  reading       Decimal   @db.Decimal(12, 2)
  unitOfMeasure String?
  readingDate   DateTime  @default(now())
  notes         String?

  createdAt DateTime @default(now())

  @@index([organizationId, moveInId])
  @@map("move_in_meter_readings")
}

model MoveInKeyItem {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  moveInId       String
  moveIn         MoveIn       @relation(fields: [moveInId], references: [id], onDelete: Cascade)

  keyType     KeyType
  description String
  quantity    Int     @default(1)
  identifier  String?

  // Whether this item is expected back at a future Move-Out (Step 60's
  // "Keys Issued vs Keys Returned" comparison) - true for almost everything
  // handed over at Move-In.
  returnedExpected Boolean @default(true)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, moveInId])
  @@map("move_in_key_items")
}

/// Metadata-only (Step 19/51): no storage architecture exists in this
/// codebase today beyond the 1MB base64-in-DB organization logo, which
/// this module deliberately does NOT reuse (Move-In can accumulate dozens
/// of photos - storing them as Postgres bytes is explicitly out of scope).
/// `storageKey`/`fileUrl` are nullable placeholders for a future object-
/// storage integration; every row created today is a caption/filename
/// reference only, with no binary content stored anywhere. See
/// docs/MOVE-IN-HANDOVER.md, "Attachment/photo strategy".
model MoveInAttachment {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  moveInId       String
  moveIn         MoveIn       @relation(fields: [moveInId], references: [id], onDelete: Cascade)

  // At most one of these two is set - a photo can document one specific
  // checklist/inventory line, or the Move-In as a whole when both are null.
  inspectionItemId String?
  inspectionItem   MoveInInspectionItem? @relation(fields: [inspectionItemId], references: [id], onDelete: SetNull)
  inventoryItemId  String?
  inventoryItem    MoveInInventoryItem?  @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)

  attachmentType MoveInAttachmentType

  fileName   String
  mimeType   String
  fileSize   Int?
  storageKey String? // nullable - populated once real object storage is integrated (see model doc comment)

  caption String?

  uploadedByUserId String

  createdAt DateTime @default(now())

  @@index([organizationId, moveInId])
  @@map("move_in_attachments")
}

// ---------------------------------------------------------------------------
// Move-Out Management
//
// Physical unit hand-back at the end of a tenancy: Preparation -> Inspection
// -> Findings Review -> Tenant Acknowledgement -> Completion. Deliberately a
// separate model family from Move-In, never a shared table - Move-Out reads
// its originating Move-In (and its inspection/inventory/meter/key rows) as
// read-only historical baseline data to compare against, and NEVER writes
// back to any Move-In* table (see docs/MOVE-OUT-MANAGEMENT.md).
//
// Move-Out is deliberately decoupled from Contract lifecycle (Phase 2
// Decision 2): creating, progressing, or completing a Move-Out never
// terminates, expires, renews, or otherwise mutates a Contract, and never
// creates/alters any Invoice/Payment/PaymentSchedule/OwnerLedgerEntry
// (Decision 3/4) - it is an operational record of physical hand-back only.
// Completing a Move-Out is instead the sole, authoritative trigger that may
// set Unit.status = VACANT (Decision 1) - see completeMoveOut() in
// src/lib/actions/move-outs.ts for the strict re-validation this requires.
// ---------------------------------------------------------------------------

enum MoveOutStatus {
  DRAFT
  SCHEDULED
  IN_PROGRESS
  PENDING_FINDINGS_REVIEW
  READY_FOR_CLOSURE
  COMPLETED
  CANCELLED
}

enum MoveOutCancelReason {
  CONTRACT_REINSTATED // tenant is staying after all (renewal, dispute resolved, termination reversed)
  TENANT_REQUEST
  RESCHEDULED
  DATA_ERROR
  OTHER
}

model MoveOut {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // "MO-000001" via the existing Counter infrastructure (key "moveOut"),
  // never a separate numbering scheme.
  moveOutNumber String

  // Required - a Move-Out always traces back to one Contract that is
  // ACTIVE or TERMINATED at creation time (RENEWED/DRAFT are not eligible -
  // see blocksNewMoveOutForContract()/resolveMoveOutEligibility() in
  // src/lib/operations/move-out-rules.ts). unitId/renterId are copied from
  // the Contract at creation and never allowed to diverge - same pattern
  // MoveIn.unitId/renterId already established from Contract.
  contractId String
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Restrict)
  unitId     String
  unit       Unit     @relation(fields: [unitId], references: [id], onDelete: Restrict)
  renterId   String
  renter     Renter   @relation(fields: [renterId], references: [id], onDelete: Restrict)

  // Optional - the Move-In this Move-Out is hand-back for, when one exists
  // on record (older Contracts predating this system may have none).
  // Reference-only, SetNull: Move-Out reads this relation to build its
  // baseline comparison (§ below) but never writes to it or anything
  // reachable through it.
  moveInId String?
  moveIn   MoveIn? @relation(fields: [moveInId], references: [id], onDelete: SetNull)

  status MoveOutStatus @default(DRAFT)

  scheduledAt DateTime?
  startedAt   DateTime?
  completedAt DateTime?
  // The actual date physical vacancy was confirmed - distinct from
  // completedAt (the system timestamp of finishing the workflow), same
  // completedAt-vs-handoverDate distinction MoveIn already draws.
  vacateDate  DateTime?

  // Live operational assignment - same pattern as MoveIn's own
  // inspectedByUserId/handedOverByUserId: a real relation, verified
  // same-organization on every write.
  inspectedByUserId  String?
  inspectedByUser    User?   @relation("MoveOutInspectedBy", fields: [inspectedByUserId], references: [id], onDelete: SetNull)
  handedOverByUserId String?
  handedOverByUser   User?   @relation("MoveOutHandedOverBy", fields: [handedOverByUserId], references: [id], onDelete: SetNull)

  // Set once, on PENDING_FINDINGS_REVIEW -> READY_FOR_CLOSURE (the one step
  // with no Move-In equivalent) - a distinct authorized staff member
  // confirming the compiled findings/damages have been reviewed, separate
  // from whoever performed the physical inspection.
  findingsReviewedAt       DateTime?
  findingsReviewedByUserId String?
  findingsReviewedByUser   User?     @relation("MoveOutFindingsReviewedBy", fields: [findingsReviewedByUserId], references: [id], onDelete: SetNull)

  // Free-text tenant-representative identity captured at hand-back - not a
  // User/Renter relation, same reasoning as MoveIn's own pair.
  tenantRepresentativeName String?
  tenantRepresentativeId   String?

  overallCondition ConditionRating?

  tenantComments String?
  internalNotes  String?

  // Operational acknowledgement (not a legal e-signature) - identical
  // "tenant acknowledgement OR authorized override" pattern MoveIn already
  // established, always paired with a reason.
  tenantAcknowledgedAt                DateTime?
  tenantAcknowledgementOverride       Boolean   @default(false)
  tenantAcknowledgementOverrideReason String?
  staffAcknowledgedAt                 DateTime?

  // Set true only when staff explicitly confirms there are nothing to
  // reconcile keys against (no linked Move-In, or the linked Move-In
  // recorded no keys) - mirrors MoveIn.noKeysToRecord's own escape hatch.
  noKeysToReturn Boolean @default(false)

  cancelReason     MoveOutCancelReason?
  cancelReasonNote String?
  cancelledAt      DateTime?

  // Plain string, not a relation - survives the creating User being
  // removed, same as every other module in this schema.
  createdByUserId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inspectionItems     MoveOutInspectionItem[]
  inventoryItems      MoveOutInventoryItem[]
  meterReadings       MoveOutMeterReading[]
  keyItems            MoveOutKeyItem[]
  attachments         MoveOutAttachment[]
  maintenanceRequests MaintenanceRequest[]
  // One settlement per completed Move-Out (Security Deposit Settlement,
  // Step 3/4) - enforced at the DB level by this relation being to a
  // singular optional field on MoveOut is NOT how this is modeled;
  // uniqueness is instead enforced by `SecurityDepositSettlement.moveOutId`
  // itself being `@unique` (see that model) - a MoveOut may have zero or
  // one settlement, never two.
  settlement          SecurityDepositSettlement?

  @@unique([organizationId, moveOutNumber])
  @@index([organizationId, status])
  @@index([organizationId, contractId])
  @@index([organizationId, unitId])
  @@index([organizationId, renterId])
  @@index([organizationId, scheduledAt])
  @@index([organizationId, vacateDate])
  @@map("move_outs")
}

model MoveOutInspectionItem {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  moveOutId      String
  moveOut        MoveOut      @relation(fields: [moveOutId], references: [id], onDelete: Cascade)

  category InspectionCategory

  itemName   String
  itemNameAr String?

  condition ConditionRating?

  isApplicable Boolean @default(true)

  notes             String?
  requiresAttention Boolean @default(false)

  sequence Int

  // Optional pointer to the specific Move-In baseline item this one is
  // being compared against - reference-only, SetNull. Lets the findings
  // summary compute a direct before/after condition delta for items that
  // have one, while still allowing Move-Out-only items (e.g. a defect that
  // only appeared after move-in) with no baseline counterpart at all.
  // Move-Out NEVER writes to the row this points at.
  moveInInspectionItemId String?
  moveInInspectionItem   MoveInInspectionItem? @relation(fields: [moveInInspectionItemId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attachments          MoveOutAttachment[]
  maintenanceRequests  MaintenanceRequest[]
  liabilityAssessments MoveOutLiabilityAssessment[]

  @@index([organizationId, moveOutId])
  @@index([moveOutId, category])
  @@map("move_out_inspection_items")
}

model MoveOutInventoryItem {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  moveOutId      String
  moveOut        MoveOut      @relation(fields: [moveOutId], references: [id], onDelete: Cascade)

  // Reuses InspectionCategory, same as MoveInInventoryItem - no second
  // furniture-specific category enum. Diffed against MoveInInventoryItem
  // by category + itemName (never a stored row-to-row link - furniture
  // isn't individually tracked with a stable identity across the two
  // records, per docs/MOVE-OUT-MANAGEMENT.md's own comparison design).
  category InspectionCategory
  itemName String

  quantity Int @default(1)

  condition ConditionRating?

  serialNumber String?
  brand        String?
  model        String?
  notes        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attachments          MoveOutAttachment[]
  liabilityAssessments MoveOutLiabilityAssessment[]

  @@index([organizationId, moveOutId])
  @@map("move_out_inventory_items")
}

model MoveOutMeterReading {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  moveOutId      String
  moveOut        MoveOut      @relation(fields: [moveOutId], references: [id], onDelete: Cascade)

  // Reuses MeterType - diffed against the matching MoveInMeterReading by
  // meterType (consumption = this reading - the Move-In reading, a pure
  // calculation, never itself stored as a third value).
  meterType     MeterType
  meterNumber   String?
  reading       Decimal   @db.Decimal(12, 2)
  unitOfMeasure String?
  readingDate   DateTime  @default(now())
  notes         String?

  createdAt DateTime @default(now())

  @@index([organizationId, moveOutId])
  @@map("move_out_meter_readings")
}

model MoveOutKeyItem {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  moveOutId      String
  moveOut        MoveOut      @relation(fields: [moveOutId], references: [id], onDelete: Cascade)

  // Reuses KeyType. Records what was actually returned; reconciled against
  // the linked Move-In's own MoveInKeyItem rows (returnedExpected = true)
  // by keyType + description - see computeKeyReturnReconciliation() in
  // src/lib/operations/move-out-rules.ts.
  keyType     KeyType
  description String
  quantity    Int     @default(1)
  identifier  String?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  liabilityAssessments MoveOutLiabilityAssessment[]

  @@index([organizationId, moveOutId])
  @@map("move_out_key_items")
}

/// Metadata-only, mirrors MoveInAttachment exactly (see
/// docs/STORAGE-ARCHITECTURE.md) - reuses MoveInAttachmentType rather than
/// forking a second identical enum.
model MoveOutAttachment {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  moveOutId      String
  moveOut        MoveOut      @relation(fields: [moveOutId], references: [id], onDelete: Cascade)

  // At most one of these two is set - a photo can document one specific
  // checklist/inventory line, or the Move-Out as a whole when both are null.
  inspectionItemId String?
  inspectionItem   MoveOutInspectionItem? @relation(fields: [inspectionItemId], references: [id], onDelete: SetNull)
  inventoryItemId  String?
  inventoryItem    MoveOutInventoryItem?  @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)

  attachmentType MoveInAttachmentType

  fileName   String
  mimeType   String
  fileSize   Int?
  storageKey String?

  caption String?

  uploadedByUserId String

  createdAt DateTime @default(now())

  @@index([organizationId, moveOutId])
  @@map("move_out_attachments")
}

// ---------------------------------------------------------------------------
// Maintenance Management
//
// Workflow: Maintenance Request -> Triage -> Work Order -> Assignment ->
// Scheduling -> Diagnosis -> Work In Progress -> Parts/Operational Costs ->
// Completion -> Verification -> Closure. Covers Compound common areas,
// Building common areas, and Units (occupied or vacant).
//
// MaintenanceRequest ("something is wrong / maintenance is needed") and
// MaintenanceWorkOrder ("authorized operational work to resolve it") are
// deliberately separate models, never collapsed - see
// docs/MAINTENANCE-MANAGEMENT.md. For V1 a Request has at most one
// non-cancelled Work Order (enforced by blocksNewWorkOrderForRequest(), the
// same app-layer-predicate-in-a-Serializable-transaction pattern already
// used by blocksNewMoveInForContract()) - the relation itself is one-to-many
// so a future follow-up Work Order remains possible without a migration.
//
// CRITICAL FINANCIAL BOUNDARY: every cost field/model here is OPERATIONAL
// ("what did this job cost?"), never accounting ("who is billed and how is
// it posted?"). Nothing in this section ever creates an Invoice, Payment,
// PaymentSchedule, OwnerLedgerEntry, or VAT record. `costResponsibility` is
// a preliminary operational classification only - not a chargeback.
//
// Location model: Unit maintenance hangs off Unit (Compound/Building are
// denormalized onto the Request from Unit -> Floor -> Building -> Compound
// at creation, via resolveMaintenanceLocation(), never trusted from the
// client). Building/Compound common-area maintenance hangs off Building/
// Compound directly with no fake Unit relation. Maintenance never writes
// to Unit.status (mirrors Move-In's own precedent - see UnitStatus.MAINTENANCE
// doc comment).
// ---------------------------------------------------------------------------

enum MaintenanceScopeType {
  UNIT
  BUILDING_COMMON_AREA
  COMPOUND_COMMON_AREA
}

enum MaintenanceCategory {
  PLUMBING
  ELECTRICAL
  AIR_CONDITIONING
  APPLIANCE
  CARPENTRY
  PAINTING
  CIVIL
  FLOORING
  DOORS_WINDOWS
  ELEVATOR
  POOL
  LANDSCAPING
  PEST_CONTROL
  CLEANING
  FIRE_SAFETY
  SECURITY_SYSTEM
  INTERNET_TELECOM
  GENERAL
  OTHER
}

// Operational urgency - deliberately independent of MaintenanceCategory (an
// EMERGENCY is never derived solely from category; a plumbing leak can be
// LOW or EMERGENCY depending on the actual situation).
enum MaintenancePriority {
  LOW
  NORMAL
  HIGH
  URGENT
  EMERGENCY
}

// Kept deliberately simple (Step 8) - detailed execution status lives on
// MaintenanceWorkOrder, not here. Valid transitions centralized in
// src/lib/operations/maintenance-rules.ts.
enum MaintenanceRequestStatus {
  OPEN
  TRIAGED
  WORK_ORDER_CREATED
  RESOLVED
  CANCELLED
}

enum MaintenanceRequestSource {
  INTERNAL
  TENANT
  MOVE_IN_INSPECTION
  MOVE_OUT_INSPECTION
  MANAGEMENT
  SECURITY
  HOUSEKEEPING
  OTHER
}

// Descriptive only - none of these create a portal account (no Tenant
// Portal/Owner Portal/Vendor Portal in this task).
enum MaintenanceReportedByType {
  STAFF
  TENANT
  OWNER
  SECURITY
  HOUSEKEEPING
  MANAGEMENT
  CORPORATE_OCCUPANT
  OTHER
}

// Shared by MaintenanceRequest.cancelReason and MaintenanceWorkOrder.cancelReason -
// both are "why was this abandoned before completion" and don't need
// separate vocabularies.
enum MaintenanceCancelReason {
  DUPLICATE
  NOT_NEEDED
  TENANT_WITHDREW
  RESOLVED_INFORMALLY
  DATA_ERROR
  OTHER
}

// Suggested lifecycle: DRAFT -> ASSIGNED -> SCHEDULED -> IN_PROGRESS ->
// COMPLETED -> VERIFIED -> CLOSED, with legitimate variations (ASSIGNED/
// SCHEDULED -> IN_PROGRESS directly, IN_PROGRESS <-> ON_HOLD, cancellation
// any time before COMPLETED). CLOSED is terminal - no reopen in V1 (Step
// 57); a recurring issue gets a new Request referencing this one instead.
// Valid transitions centralized in src/lib/operations/maintenance-rules.ts.
enum MaintenanceWorkOrderStatus {
  DRAFT
  ASSIGNED
  SCHEDULED
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  VERIFIED
  CLOSED
  CANCELLED
}

enum MaintenanceHoldReason {
  WAITING_FOR_PART
  WAITING_FOR_VENDOR
  WAITING_FOR_TENANT
  WAITING_FOR_APPROVAL
  ACCESS_UNAVAILABLE
  OTHER
}

// Append-only operational history a user reads (distinct from AuditLog,
// which is the security/compliance mutation trail - Step 78).
enum MaintenanceWorkLogType {
  NOTE
  STATUS_UPDATE
  DIAGNOSIS
  WORK_PERFORMED
  CUSTOMER_UPDATE
  INTERNAL_NOTE
  OTHER
}

// Preliminary operational classification only (Step 36) - never creates an
// accounting entry, chargeback, or deposit deduction.
enum MaintenanceCostResponsibility {
  UNDETERMINED
  OWNER
  TENANT
  PROPERTY_MANAGEMENT
  WARRANTY
  VENDOR
  OTHER
}

// INVOICE_COPY means a vendor/source document attachment (e.g. a vendor's
// paper invoice photographed for the record) - it is NOT a system
// accounting Invoice and never creates one.
enum MaintenanceAttachmentType {
  PHOTO
  VIDEO
  DOCUMENT
  INVOICE_COPY
  QUOTE
  OTHER
}

enum MaintenanceAttachmentStage {
  BEFORE
  DURING
  AFTER
  GENERAL
}

enum MaintenanceCostEntryType {
  TRANSPORT
  EXTERNAL_SERVICE
  EQUIPMENT_RENTAL
  MISCELLANEOUS
  OTHER
}

model MaintenanceRequest {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // "MR-000001" via the existing Counter infrastructure (key
  // "maintenanceRequest") - no new numbering scheme.
  requestNumber String

  scopeType MaintenanceScopeType

  // Denormalized onto the Request from the authoritative source
  // (Unit -> Floor -> Building -> Compound for UNIT scope; the given
  // Building/Compound directly otherwise) by resolveMaintenanceLocation() -
  // never trusted as given by the client. Exactly one combination is valid
  // per scopeType; see that helper for the enforced rules. Explicit
  // onDelete: Restrict (Prisma's own default for an optional relation is
  // SetNull, which is right for a pure reference like MoveIn/
  // MoveInInspectionItem below but wrong here - a Maintenance Request's
  // location is core, not incidental, so deleting a Compound/Building/Unit
  // that still has Maintenance history must fail, exactly like Contract's
  // required unitId/renterId already do).
  compoundId String?
  compound   Compound? @relation(fields: [compoundId], references: [id], onDelete: Restrict)
  buildingId String?
  building   Building? @relation(fields: [buildingId], references: [id], onDelete: Restrict)
  unitId     String?
  unit       Unit?     @relation(fields: [unitId], references: [id], onDelete: Restrict)

  // UNIT scope only, optional even then (vacant-unit maintenance needs
  // neither) - when supplied, verified same-org and mutually consistent
  // (Contract's unit must equal unitId; Renter must relate to that
  // Contract) by resolveMaintenanceLocation(), never trusted standalone.
  // Same Restrict reasoning as above.
  contractId String?
  contract   Contract? @relation(fields: [contractId], references: [id], onDelete: Restrict)
  renterId   String?
  renter     Renter?   @relation(fields: [renterId], references: [id], onDelete: Restrict)

  category MaintenanceCategory
  priority MaintenancePriority      @default(NORMAL)
  status   MaintenanceRequestStatus @default(OPEN)

  title       String
  description String?

  reportedByType   MaintenanceReportedByType
  reportedByUserId String?
  reportedByUser   User?                     @relation("MaintenanceRequestReportedBy", fields: [reportedByUserId], references: [id], onDelete: SetNull)
  reportedByName   String?
  reportedByPhone  String?
  reportedAt       DateTime                  @default(now())

  // Corporate Housing traceability only (docs/CORPORATE-HOUSING.md,
  // "Occupant reporter architecture") - a CorporateOccupant is never a
  // Renter/Contract party/Invoice customer; this is a read-only pointer so
  // internal staff can see which employee reported an issue, set only when
  // reportedByType = CORPORATE_OCCUPANT. onDelete: SetNull mirrors
  // reportedByUserId's own pattern - deleting the occupant record must
  // never cascade-delete Maintenance history.
  corporateOccupantId String?
  corporateOccupant   CorporateOccupant? @relation(fields: [corporateOccupantId], references: [id], onDelete: SetNull)

  preferredVisitDate  DateTime?
  preferredTimeWindow String?
  permissionToEnter   Boolean?

  source MaintenanceRequestSource @default(INTERNAL)

  // Preliminary responsible-person assignment set at triage - independent
  // of whatever the resulting Work Order itself is assigned to.
  assignedToUserId String?
  assignedToUser   User?   @relation("MaintenanceRequestAssignedTo", fields: [assignedToUserId], references: [id], onDelete: SetNull)

  triagedAt       DateTime?
  triagedByUserId String?
  triagedByUser   User?     @relation("MaintenanceRequestTriagedBy", fields: [triagedByUserId], references: [id], onDelete: SetNull)
  triageNotes     String?

  // SLA (Step 25-28): responseDueAt/resolutionDueAt are computed once at
  // creation from reportedAt + the centralized SLA_POLICY for `priority`
  // and never recalculated - a later priority change or future policy
  // update does not rewrite an already-created Request's targets.
  // firstResponseAt is set once, on first successful triage, and never
  // overwritten afterward.
  responseDueAt   DateTime?
  resolutionDueAt DateTime?
  firstResponseAt DateTime?
  resolvedAt      DateTime?

  cancelledAt      DateTime?
  cancelReason     MaintenanceCancelReason?
  cancelReasonNote String?

  // Move-In defect traceability (Step 39-40) - reference only. Creating a
  // Request from a Move-In defect never mutates the MoveIn/inspection item.
  moveInId               String?
  moveIn                 MoveIn?               @relation(fields: [moveInId], references: [id], onDelete: SetNull)
  moveInInspectionItemId String?
  moveInInspectionItem   MoveInInspectionItem? @relation(fields: [moveInInspectionItemId], references: [id], onDelete: SetNull)

  // Move-Out defect traceability - reference only. Creating a Request from
  // a Move-Out finding never mutates the MoveOut/inspection item.
  moveOutId               String?
  moveOut                 MoveOut?               @relation(fields: [moveOutId], references: [id], onDelete: SetNull)
  moveOutInspectionItemId String?
  moveOutInspectionItem   MoveOutInspectionItem? @relation(fields: [moveOutInspectionItemId], references: [id], onDelete: SetNull)

  // Plain string, not a relation - survives the creating User being removed
  // (same pattern as MoveIn.createdByUserId and every other module here).
  createdByUserId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workOrders           MaintenanceWorkOrder[]
  attachments          MaintenanceAttachment[]
  liabilityAssessments MoveOutLiabilityAssessment[]

  @@unique([organizationId, requestNumber])
  @@index([organizationId, status])
  @@index([organizationId, priority])
  @@index([organizationId, category])
  @@index([organizationId, unitId])
  @@index([organizationId, compoundId])
  @@index([organizationId, buildingId])
  @@index([organizationId, reportedAt])
  @@index([organizationId, responseDueAt])
  @@index([organizationId, resolutionDueAt])
  @@map("maintenance_requests")
}

model MaintenanceWorkOrder {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // "WO-000001" via Counter (key "maintenanceWorkOrder").
  workOrderNumber String

  requestId String
  request   MaintenanceRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)

  status   MaintenanceWorkOrderStatus @default(DRAFT)
  priority MaintenancePriority

  // One responsible party: internal User OR Vendor, never both (Step 22) -
  // enforced in the service layer and, as defense-in-depth, by a Postgres
  // CHECK constraint added via raw SQL in this model's migration (mirrors
  // PropertyOwnership's own num_nonnulls(...) CHECK precedent).
  assignedToUserId String?
  assignedToUser   User?              @relation("MaintenanceWorkOrderAssignedTo", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  vendorId         String?
  vendor           MaintenanceVendor? @relation(fields: [vendorId], references: [id])

  scheduledStart DateTime?
  scheduledEnd   DateTime?

  startedAt   DateTime?
  diagnosedAt DateTime?
  completedAt DateTime?
  verifiedAt  DateTime?
  closedAt    DateTime?

  diagnosis        String?
  workPerformed    String?
  completionNotes  String?
  requiresFollowUp Boolean @default(false)

  holdReason     MaintenanceHoldReason?
  holdReasonNote String?

  estimatedCost Decimal? @db.Decimal(12, 2)
  // Server-recalculated on every Labor/Parts/Cost entry mutation from
  // computeMaintenanceCostSummary() - never trusted from the client
  // (Step 34/85).
  actualCost    Decimal? @db.Decimal(12, 2)

  // Preliminary operational classification only - see enum doc comment.
  costResponsibility MaintenanceCostResponsibility @default(UNDETERMINED)

  verifiedByUserId  String?
  verifiedByUser    User?   @relation("MaintenanceWorkOrderVerifiedBy", fields: [verifiedByUserId], references: [id], onDelete: SetNull)
  verificationNotes String?

  cancelledAt      DateTime?
  cancelReason     MaintenanceCancelReason?
  cancelReasonNote String?

  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workLogs     MaintenanceWorkLog[]
  laborEntries MaintenanceLaborEntry[]
  partEntries  MaintenancePartEntry[]
  costEntries  MaintenanceCostEntry[]
  attachments  MaintenanceAttachment[]

  @@unique([organizationId, workOrderNumber])
  @@index([organizationId, status])
  @@index([organizationId, requestId])
  @@index([organizationId, assignedToUserId])
  @@index([organizationId, vendorId])
  @@index([organizationId, scheduledStart])
  @@index([organizationId, createdAt])
  @@map("maintenance_work_orders")
}

// Lightweight - no Vendor Portal, no login. Belongs to exactly one
// Organization; an inactive Vendor may keep its historical Work Order
// relations but cannot receive new assignments (enforced in the service
// layer). Never hard-deleted (Step 73) - only deactivated.
model MaintenanceVendor {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // "VEN-000001" via Counter (key "maintenanceVendor") - generated, not
  // client-supplied, for the same concurrency-safety reason as every other
  // numbered entity in this schema.
  vendorNumber String

  name          String
  nameAr        String?
  contactPerson String?
  phone         String?
  email         String?

  active Boolean @default(true)
  notes  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  specialties  MaintenanceVendorSpecialty[]
  workOrders   MaintenanceWorkOrder[]
  laborEntries MaintenanceLaborEntry[]

  @@unique([organizationId, vendorNumber])
  @@index([organizationId, active])
  @@map("maintenance_vendors")
}

// Relational specialties (Step 20 - "prefer relational if simple" over an
// uncontrolled comma-separated string), so "find every vendor who does
// PLUMBING" is a normal indexed query.
model MaintenanceVendorSpecialty {
  id       String            @id @default(cuid())
  vendorId String
  vendor   MaintenanceVendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  category MaintenanceCategory

  createdAt DateTime @default(now())

  @@unique([vendorId, category])
  @@map("maintenance_vendor_specialties")
}

// User-facing operational history, immutable/append-only by convention
// (rows are never edited or deleted by the application) - distinct from
// AuditLog (Step 78). organizationId is a plain scoping column, not a
// relation (same pattern as ViewingUnit.organizationId), since every row
// is always reached through its already-org-scoped MaintenanceWorkOrder
// parent.
model MaintenanceWorkLog {
  id             String @id @default(cuid())
  organizationId String

  workOrderId String
  workOrder   MaintenanceWorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  logType MaintenanceWorkLogType
  note    String

  createdByUserId String
  createdAt       DateTime @default(now())

  attachments MaintenanceAttachment[]

  @@index([organizationId, workOrderId])
  @@map("maintenance_work_logs")
}

// Operational costing only - see the model-group doc comment above for the
// financial boundary. `cost` is always server-computed (hours x hourlyRate
// when a rate is given, otherwise entered directly) and Decimal throughout,
// never floating-point JS arithmetic.
model MaintenanceLaborEntry {
  id             String @id @default(cuid())
  organizationId String

  workOrderId String
  workOrder   MaintenanceWorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  // At most one of these two is meaningfully set, matching the Work
  // Order's own "internal User OR Vendor" responsible-party rule - not
  // DB-enforced here since either or neither may be known for a given
  // labor line (e.g. a vendor's own internal labor breakdown).
  userId   String?
  user     User?              @relation("MaintenanceLaborEntryUser", fields: [userId], references: [id], onDelete: SetNull)
  vendorId String?
  vendor   MaintenanceVendor? @relation(fields: [vendorId], references: [id])

  description String
  hours       Decimal  @db.Decimal(6, 2)
  hourlyRate  Decimal? @db.Decimal(10, 2)
  cost        Decimal  @db.Decimal(12, 2)
  workDate    DateTime

  createdByUserId String
  createdAt       DateTime @default(now())

  @@index([organizationId, workOrderId])
  @@map("maintenance_labor_entries")
}

// totalCost is always quantity x unitCost, computed server-side - never
// trusted from the client (Step 32/85).
model MaintenancePartEntry {
  id             String @id @default(cuid())
  organizationId String

  workOrderId String
  workOrder   MaintenanceWorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  itemName     String
  quantity     Int
  unitCost     Decimal @db.Decimal(12, 2)
  totalCost    Decimal @db.Decimal(12, 2)
  supplierName String?
  reference    String?

  createdByUserId String
  createdAt       DateTime @default(now())

  @@index([organizationId, workOrderId])
  @@map("maintenance_part_entries")
}

// Catch-all operational cost line (transport, external service, equipment
// rental, misc.) - kept separate from Labor/Parts rather than overloading
// either (Step 33).
model MaintenanceCostEntry {
  id             String @id @default(cuid())
  organizationId String

  workOrderId String
  workOrder   MaintenanceWorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  costType    MaintenanceCostEntryType
  description String
  amount      Decimal                  @db.Decimal(12, 2)
  reference   String?
  date        DateTime

  createdByUserId String
  createdAt       DateTime @default(now())

  @@index([organizationId, workOrderId])
  @@map("maintenance_cost_entries")
}

// Metadata-only (mirrors MoveInAttachment exactly - see
// docs/STORAGE-ARCHITECTURE.md): no binary column, `storageKey` is a
// nullable placeholder for a future real object-storage integration.
// Exactly one of requestId/workOrderId/workLogId is normally set (a photo
// documents one specific record); all three nullable so the same model
// covers every attachment point named in Step 37 without three near-
// identical tables. INVOICE_COPY here means a vendor/source document scan,
// never a system accounting Invoice.
model MaintenanceAttachment {
  id             String @id @default(cuid())
  organizationId String

  requestId   String?
  request     MaintenanceRequest?   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  workOrderId String?
  workOrder   MaintenanceWorkOrder? @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  workLogId   String?
  workLog     MaintenanceWorkLog?   @relation(fields: [workLogId], references: [id], onDelete: Cascade)

  attachmentType MaintenanceAttachmentType
  stage          MaintenanceAttachmentStage @default(GENERAL)

  fileName   String
  mimeType   String
  fileSize   Int?
  storageKey String?

  caption String?

  uploadedByUserId String
  createdAt        DateTime @default(now())

  @@index([organizationId, requestId])
  @@index([organizationId, workOrderId])
  @@index([organizationId, workLogId])
  @@map("maintenance_attachments")
}

// ---------------------------------------------------------------------------
// Security Deposit & Move-Out Financial Settlement
//
// This is the financial-settlement layer that follows a COMPLETED Move-Out
// (see docs/SECURITY-DEPOSIT-SETTLEMENT.md). It is a dedicated domain, never
// collapsed into MoveOut/Invoice/Payment/OwnerLedgerEntry/MaintenanceRequest:
//
//   Move-In Baseline -> Move-Out Final Condition -> Findings ->
//   Liability Assessment -> Proposed/Approved Deductions -> Review ->
//   Approval -> Posting -> Deposit Application -> Refund / Additional
//   Amount Due
//
// CRITICAL PRINCIPLE (never to be weakened): FINDING != TENANT LIABILITY !=
// FINANCIAL DEDUCTION. A Move-Out inspection/inventory/key finding, or a
// MaintenanceRequest/WorkOrder cost, is evidence only. Nothing in this
// section (or anywhere else in this codebase) may auto-create a tenant
// charge from a finding. An authorized human must explicitly assess
// responsibility, then a distinct authorized approver must explicitly
// approve an amount, before any financial posting can occur.
//
// Existing invariants this section NEVER touches:
//   - completeMoveOut() remains the sole path to Unit.status = VACANT.
//   - MoveOut/MoveIn inspection/inventory/meter/key/attachment rows are
//     read-only evidence here - never mutated.
//   - Contract.status is never changed by settlement activity.
//   - OwnerLedgerEntry is never posted to automatically merely because a
//     deposit was collected or a tenant deduction was approved - a
//     collected deposit is a liability held on the tenant's behalf, not
//     owner income (see docs/SECURITY-DEPOSIT-SETTLEMENT.md, "Owner
//     accounting boundary" - deferred, future integration).
//
// Deposit collection itself reuses the EXISTING Invoice/Payment pipeline
// unchanged (InvoiceLineKind.SECURITY_DEPOSIT already exists, billed at 0%
// VAT - see issueInvoiceForSchedule()). What was missing, and is added
// here, is (a) an authoritative, ledger-backed "available balance" that
// survives partial/mixed invoicing exactly the way recomputeScheduleStatus()
// already tolerates, and (b) a genuine OUTGOING-money concept (refund),
// which Payment (inbound-only, invoiceId required) cannot safely represent -
// see docs/SECURITY-DEPOSIT-SETTLEMENT.md, "Why Payment/OwnerLedgerEntry
// were not reused for refunds."
// ---------------------------------------------------------------------------

enum SettlementStatus {
  DRAFT // preparer (assessment phase) - freely editable
  UNDER_REVIEW // submitted for a second look; reviewer may send back to DRAFT
  PENDING_APPROVAL // reviewed; awaiting the authorized approver's decision
  APPROVED // commercial snapshot frozen (approved* fields set) - assessment editing stops
  POSTED // financial movements created (ledger APPLICATION/REFUND-obligation, additional-due invoice if any)
  PARTIALLY_SETTLED // posted, and at least one of refund/additional-due is partially but not fully cleared
  SETTLED // posted, and refund fully paid (if any) and additional-due handled per the documented completion definition
  CANCELLED // terminal, only reachable before POSTED
}

enum SettlementResponsibility {
  TENANT
  OWNER
  PROPERTY_MANAGEMENT
  VENDOR
  WARRANTY
  UNDETERMINED
  NO_CHARGE
  OTHER
}

// Deliberately excludes UNPAID_RENT/UNPAID_UTILITY (Step 13/46): this
// codebase already tracks unpaid rent authoritatively via
// PaymentSchedule/Invoice, and has no utility-billing feature at all, so
// neither can be safely re-derived here without risking double-charging or
// fabricating a balance this module cannot prove. A genuinely unpaid-rent
// deduction is entered as OTHER_CONTRACTUAL_CHARGE with a manual reference
// to the specific existing Invoice/PaymentSchedule row, never re-summed here.
enum SettlementDeductionCategory {
  DAMAGE
  MISSING_INVENTORY
  MISSING_KEY_OR_ACCESS_DEVICE
  CLEANING
  MAINTENANCE
  OTHER_CONTRACTUAL_CHARGE
  OTHER
}

enum AssessmentSourceType {
  INSPECTION_ITEM
  INVENTORY_ITEM
  KEY_ITEM
  MAINTENANCE_REQUEST
  OTHER
}

enum SettlementDisputeStatus {
  NONE
  RAISED
  UNDER_REVIEW
  RESOLVED
}

enum SecurityDepositLedgerEntryType {
  COLLECTION // credit - deposit money actually collected (derived from a paid SECURITY_DEPOSIT invoice line, never manually fabricated)
  APPLICATION // debit - portion of the deposit applied against approved tenant deductions at posting
  REFUND // debit - portion of the deposit paid back out to the tenant
  ADJUSTMENT // either side - a rare, explicit, audited correction (e.g. correcting a sync error) - never used to hide a mistake
  REVERSAL // opposite of whatever entry it reverses
}

enum SecurityDepositRefundStatus {
  PENDING
  APPROVED
  PAID
  CANCELLED
}

/// One per COMPLETED MoveOut (moveOutId is @unique below - enforced at the
/// DB level, not just in application code). Orchestrates settlement while
/// every source record (MoveOut, its inspection/inventory/key items,
/// MaintenanceRequest) remains untouched and authoritative for what actually
/// happened; this model only ever reads them.
model SecurityDepositSettlement {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // "SDS-000001" via the existing Counter infrastructure (key
  // "securityDepositSettlement") - no new numbering scheme.
  settlementNumber String

  // Copied from the completed MoveOut at creation and never allowed to
  // diverge - same pattern MoveOut itself already established for
  // unitId/renterId copied from Contract.
  contractId String
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Restrict)
  moveOutId  String   @unique
  moveOut    MoveOut  @relation(fields: [moveOutId], references: [id], onDelete: Restrict)
  unitId     String
  unit       Unit     @relation(fields: [unitId], references: [id], onDelete: Restrict)
  renterId   String
  renter     Renter   @relation(fields: [renterId], references: [id], onDelete: Restrict)

  status SettlementStatus @default(DRAFT)

  // Frozen commercial snapshot (Step 49/50) - null until APPROVED, and never
  // recalculated afterward even if a source record could theoretically
  // change later. Posting reuses these exact figures; it never
  // re-derives new ones.
  approvedAvailableDeposit Decimal? @db.Decimal(12, 2)
  approvedTenantDeductions Decimal? @db.Decimal(12, 2)
  approvedDepositApplied   Decimal? @db.Decimal(12, 2)
  approvedRefundDue        Decimal? @db.Decimal(12, 2)
  approvedAdditionalDue    Decimal? @db.Decimal(12, 2)

  // Plain string, not a relation (the FK would need to be nullable to
  // support onDelete: SetNull, and this one is never optional) - survives
  // the preparing User being removed, same convention as
  // MoveOut.createdByUserId.
  preparedByUserId String

  reviewedByUserId String?
  reviewedByUser   User?     @relation("SettlementReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  reviewedAt       DateTime?

  approvedByUserId String?
  approvedByUser   User?     @relation("SettlementApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  approvedAt       DateTime?

  postedByUserId String?
  postedByUser   User?     @relation("SettlementPostedBy", fields: [postedByUserId], references: [id], onDelete: SetNull)
  postedAt       DateTime?

  settledAt DateTime?

  cancelledByUserId String?
  cancelledByUser   User?     @relation("SettlementCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: SetNull)
  cancelledAt       DateTime?
  cancelReason      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  liabilityAssessments  MoveOutLiabilityAssessment[]
  ledgerEntries         SecurityDepositLedgerEntry[]
  refunds               SecurityDepositRefund[]
  notesLog              SecurityDepositSettlementNote[]
  additionalDueInvoices Invoice[]

  @@unique([organizationId, settlementNumber])
  @@index([organizationId, status])
  @@index([organizationId, contractId])
  @@index([organizationId, unitId])
  @@index([organizationId, renterId])
  @@index([organizationId, createdAt])
  @@map("security_deposit_settlements")
}

/// Explicit human liability decision against one piece of Move-Out (or
/// manual) evidence. NEVER auto-created from a finding - always an
/// authorized user's deliberate action (see createLiabilityAssessment()).
/// Typed source relations (Step 12) rather than a polymorphic sourceType +
/// bare sourceId string, so referential integrity is real: exactly one of
/// the four *Id fields is set for a Move-Out-evidenced assessment, and none
/// for a manual (sourceType = OTHER) one.
model MoveOutLiabilityAssessment {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  settlementId String
  settlement   SecurityDepositSettlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)

  sourceType AssessmentSourceType

  moveOutInspectionItemId String?
  moveOutInspectionItem   MoveOutInspectionItem? @relation(fields: [moveOutInspectionItemId], references: [id], onDelete: SetNull)
  moveOutInventoryItemId  String?
  moveOutInventoryItem    MoveOutInventoryItem?  @relation(fields: [moveOutInventoryItemId], references: [id], onDelete: SetNull)
  moveOutKeyItemId        String?
  moveOutKeyItem          MoveOutKeyItem?        @relation(fields: [moveOutKeyItemId], references: [id], onDelete: SetNull)
  maintenanceRequestId    String?
  maintenanceRequest      MaintenanceRequest?    @relation(fields: [maintenanceRequestId], references: [id], onDelete: SetNull)

  description   String
  descriptionAr String?

  category         SettlementDeductionCategory
  // Defaults to UNDETERMINED (Step 9) - never inferred from a condition
  // rating or any other evidence field; always a deliberate choice.
  responsibility   SettlementResponsibility    @default(UNDETERMINED)
  assessmentReason String?

  // proposedAmount is the preparer's suggestion; approvedAmount is the
  // distinct, separately-authorized approver's decision (Step 15) - never
  // overwritten by, or used to silently overwrite, the other. Enforced in
  // the action layer (not a DB CHECK, to match this schema's existing
  // convention of application-layer invariant enforcement for cross-field
  // business rules): responsibility != TENANT => approvedAmount must be 0
  // (Step 42/43/96); approvedAmount + waivedAmount <= proposedAmount
  // (Step 16, no double counting).
  proposedAmount Decimal  @default(0) @db.Decimal(12, 2)
  approvedAmount Decimal? @db.Decimal(12, 2)
  waivedAmount   Decimal  @default(0) @db.Decimal(12, 2)
  waiverReason   String?

  disputeStatus SettlementDisputeStatus @default(NONE)
  disputeNote   String?

  // Plain string, not a relation - same reasoning as
  // SecurityDepositSettlement.preparedByUserId above.
  assessedByUserId String
  assessedAt       DateTime @default(now())

  approvedByUserId String?
  approvedByUser   User?     @relation("AssessmentApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  approvedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, settlementId])
  @@index([organizationId, responsibility])
  @@index([organizationId, disputeStatus])
  @@map("move_out_liability_assessments")
}

/// Append-only (Step 26/27) - Available Deposit Balance is ALWAYS
/// SUM(credit) - SUM(debit) over these rows for a Contract, mirroring
/// OwnerLedgerEntry's own debit/credit + reversal-linkage convention
/// exactly. There is deliberately no update/delete server action for this
/// model anywhere - a mistaken entry is corrected only by posting a
/// REVERSAL row that mirrors it (see reverseSecurityDepositLedgerEntry()).
model SecurityDepositLedgerEntry {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  contractId String
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Restrict)

  // Null for a COLLECTION entry synced before any settlement existed for
  // this Contract (deposit can be collected well before Move-Out); always
  // set for APPLICATION/REFUND, which only ever happen inside a settlement.
  settlementId String?
  settlement   SecurityDepositSettlement? @relation(fields: [settlementId], references: [id], onDelete: SetNull)

  refundId String?
  refund   SecurityDepositRefund? @relation(fields: [refundId], references: [id], onDelete: SetNull)

  entryType SecurityDepositLedgerEntryType

  debit  Decimal @default(0) @db.Decimal(12, 2)
  credit Decimal @default(0) @db.Decimal(12, 2)

  // Free-text pointer (e.g. referenceType="Invoice") for a COLLECTION entry
  // synced from an existing paid SECURITY_DEPOSIT invoice line - not a
  // Prisma relation, matching OwnerLedgerEntry's own referenceType/
  // referenceId convention exactly, for the same reason: this ledger must
  // stay postable/queryable even if the source Invoice is later restructured,
  // and must never be able to cascade-delete a financial record.
  referenceType String?
  referenceId   String?

  description   String
  descriptionAr String?

  entryDate DateTime @default(now())

  reversalOfEntryId String?                     @unique
  reversalOfEntry   SecurityDepositLedgerEntry? @relation("SecurityDepositLedgerReversal", fields: [reversalOfEntryId], references: [id])
  reversedByEntry   SecurityDepositLedgerEntry? @relation("SecurityDepositLedgerReversal")

  // Plain string, not a relation - survives the acting User being removed,
  // same as OwnerLedgerEntry.createdBy and every other ledger-tier record
  // in this schema.
  createdBy String?
  createdAt DateTime @default(now())

  @@unique([organizationId, referenceType, referenceId])
  @@index([organizationId, contractId, entryDate])
  @@index([organizationId, settlementId])
  @@map("security_deposit_ledger_entries")
}

/// A genuine OUTGOING cash movement to the tenant - deliberately NOT a
/// negative Payment (Payment.invoiceId is required and its own "reversal"
/// means something entirely different - see docs/SECURITY-DEPOSIT-
/// SETTLEMENT.md). V1 exposes one action, recordSecurityDepositRefund(),
/// which always records an already-executed payment (status is written as
/// PAID immediately, with paidAt set) - there is no separate refund-request/
/// refund-approval UI step in V1, since the settlement's own approval
/// already authorizes the refund amount; PENDING/APPROVED remain valid
/// schema states for future workflow extension without a migration.
model SecurityDepositRefund {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  settlementId String
  settlement   SecurityDepositSettlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)

  amount          Decimal                     @db.Decimal(12, 2)
  status          SecurityDepositRefundStatus @default(PAID)
  method          PaymentMethod?
  referenceNumber String?
  notes           String?

  paidAt DateTime?

  cancelledAt  DateTime?
  cancelReason String?

  // Plain string, not a relation - same ledger-tier convention as
  // SecurityDepositLedgerEntry.createdBy/OwnerLedgerEntry.createdBy.
  createdBy String?
  createdAt DateTime @default(now())

  ledgerEntries SecurityDepositLedgerEntry[]

  @@index([organizationId, settlementId])
  @@map("security_deposit_refunds")
}

/// Append-only operational discussion history for a settlement (Step 80) -
/// deliberately separate from AuditLog, which stays a pure compliance
/// record of state changes, never a comments thread.
model SecurityDepositSettlementNote {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  settlementId String
  settlement   SecurityDepositSettlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)

  // Plain string, not a relation - same reasoning as
  // SecurityDepositSettlement.preparedByUserId above.
  authorUserId String
  note         String

  createdAt DateTime @default(now())

  @@index([organizationId, settlementId])
  @@map("security_deposit_settlement_notes")
}

// =============================================================================
// TENANT PORTAL (Prompt 16) - a wholly separate identity/authorization domain
// from the internal User/UserRole system above. A TenantPortalAccount is
// never able to hold any `UserRole` permission, and `UserRole` never gains a
// TENANT value - see docs/TENANT-PORTAL.md for the full architecture
// rationale (Step 1 audit). Session identity is issued by a second,
// independent NextAuth instance (src/lib/tenant-auth.ts) with its own JWT
// shape and its own cookie name, so an internal staff session and a tenant
// session can never be confused for one another even in the same browser.
// =============================================================================

enum TenantPortalAccountStatus {
  INVITED // created by staff, temporary credential issued, never logged in yet
  ACTIVE
  SUSPENDED // reversible - staff-initiated, access stops immediately
  DISABLED // terminal in practice (tenancy ended, fraud, etc.) - never deleted
}

/// One per Renter (V1: `renterId @unique` - see docs/TENANT-PORTAL.md,
/// "Account cardinality", for the documented future multi-contact corporate
/// extension). Deliberately NOT a User: this table grants zero internal
/// permissions, and internal RBAC (`Permission`/`ROLE_PERMISSIONS`) never
/// reads from it. Every authorization check derives access from
/// TenantPortalAccount -> Renter -> Contract -> resource, never from a
/// client-supplied id alone (Step 9).
model TenantPortalAccount {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  renterId String @unique
  renter   Renter @relation(fields: [renterId], references: [id], onDelete: Restrict)

  email           String
  emailNormalized String // lowercase/trimmed, matches the internal User.email normalization convention in src/lib/auth.ts

  phone String?

  passwordHash String

  status TenantPortalAccountStatus @default(INVITED)

  mustChangePassword Boolean @default(true)

  lastLoginAt     DateTime?
  emailVerifiedAt DateTime?

  // Plain string, not a relation - survives the creating/managing internal
  // User being removed, same convention as every other actor field in this
  // schema (e.g. MoveOut.createdByUserId).
  createdByUserId String

  suspendedAt       DateTime?
  suspendedByUserId String?
  disabledAt        DateTime?
  disabledByUserId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, emailNormalized])
  @@index([organizationId, status])
  @@map("tenant_portal_accounts")
}

enum OwnerPortalAccountStatus {
  INVITED // created by staff, temporary credential issued, never logged in yet
  ACTIVE
  SUSPENDED // reversible - staff-initiated, access stops immediately
  DISABLED // terminal in practice - never deleted
}

/// One per Owner (V1: `ownerId @unique` - see docs/OWNER-PORTAL.md, "Account
/// cardinality", for the documented future multi-representative/family-
/// office/fund extension). Deliberately NOT a User and NOT a
/// TenantPortalAccount: an owner is neither an internal staff user nor a
/// tenant principal. This table grants zero internal permissions, and
/// internal RBAC (`Permission`/`ROLE_PERMISSIONS`) never reads from it.
/// Every authorization check derives access from OwnerPortalAccount ->
/// Owner -> PropertyOwnership (via the existing getEffectiveOwners()
/// resolver) -> resource, never from a client-supplied id or
/// organizationId alone.
model OwnerPortalAccount {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  ownerId String @unique
  owner   Owner  @relation(fields: [ownerId], references: [id], onDelete: Restrict)

  email           String
  emailNormalized String // lowercase/trimmed, matches the internal User.email / TenantPortalAccount.emailNormalized convention

  phone String?

  passwordHash String

  status OwnerPortalAccountStatus @default(INVITED)

  mustChangePassword Boolean @default(true)

  lastLoginAt     DateTime?
  emailVerifiedAt DateTime?

  // Plain string, not a relation - survives the creating/managing internal
  // User being removed, same convention as TenantPortalAccount.createdByUserId.
  createdByUserId String

  suspendedAt       DateTime?
  suspendedByUserId String?
  disabledAt        DateTime?
  disabledByUserId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, emailNormalized])
  @@index([organizationId, status])
  @@map("owner_portal_accounts")
}

// ---------------------------------------------------------------------------
// Corporate Housing (docs/CORPORATE-HOUSING.md) - a B2B operational layer on
// top of the existing Renter/Contract/Unit architecture, never a second
// leasing engine. CorporateAccount wraps an existing Renter (the legal, VAT-
// registered corporate customer already fully supported by Invoice/Payment)
// rather than duplicating it. CorporateOccupant (an employee physically
// residing in a Unit) is deliberately NOT a Renter, Contract party, Invoice
// customer, or Payment customer - it is a pure operational record.
// CorporateHousingAllocation ("this occupant is assigned to this corporate-
// leased Unit for this period") is deliberately NOT a lease, sublease,
// financial contract, invoice, or payment schedule - it never touches
// Unit.status or Contract.status, and never creates/mutates a MoveIn/MoveOut.
// ---------------------------------------------------------------------------

enum CorporateAccountStatus {
  PROSPECT
  ACTIVE
  INACTIVE
  SUSPENDED
}

/// The commercial B2B customer. Wraps an existing corporate Renter
/// (`renterId @unique` - one CorporateAccount per Renter, V1) rather than
/// duplicating fullName/vatNumber/contact fields already authoritatively
/// stored there - see docs/CORPORATE-HOUSING.md, "Corporate Account vs
/// Renter". A Renter with no CorporateAccount row is simply not (yet)
/// managed as a corporate account; nothing elsewhere in the codebase reads
/// this table to make that determination.
model CorporateAccount {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  renterId String @unique
  renter   Renter @relation(fields: [renterId], references: [id], onDelete: Restrict)

  // "CHA-ACC-000001"-style via the existing Counter infrastructure (key
  // "corporateAccount") - no year component, matching every other
  // non-tax-document sequence in this schema (Lead/Viewing/Offer/
  // Reservation/MoveIn/MaintenanceRequest numbers).
  accountNumber String

  // Denormalized from Renter.fullName at creation for fast list display
  // (avoids a join on every /corporate-housing/accounts row); kept in sync
  // by the update action whenever the account (not the Renter directly) is
  // edited. The Renter's own fullName remains authoritative for anything
  // financial (invoices/statements).
  displayName String

  status CorporateAccountStatus @default(PROSPECT)

  industry String?
  website  String?

  accountManagerUserId String?
  accountManagerUser   User?   @relation("CorporateAccountManager", fields: [accountManagerUserId], references: [id], onDelete: SetNull)

  notes String?

  createdByUserId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contacts    CorporateContact[]
  occupants   CorporateOccupant[]
  allocations CorporateHousingAllocation[]

  @@unique([organizationId, accountNumber])
  @@index([organizationId, status])
  @@map("corporate_accounts")
}

enum CorporateContactType {
  PRIMARY
  HR
  ADMINISTRATION
  FINANCE
  HOUSING_COORDINATOR
  EMERGENCY
  OTHER
}

/// Lightweight corporate contacts - no login account in this phase (see
/// docs/CORPORATE-HOUSING.md, "Future Corporate Portal"). Deactivated
/// (`isActive = false`), never hard-deleted, matching this schema's
/// no-hard-delete-for-history convention.
model CorporateContact {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  corporateAccountId String
  corporateAccount   CorporateAccount @relation(fields: [corporateAccountId], references: [id], onDelete: Cascade)

  name       String
  jobTitle   String?
  department String?
  email      String?
  phone      String?

  contactType CorporateContactType @default(OTHER)

  isPrimary Boolean @default(false)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  communicationMessages CommunicationMessage[]

  @@index([organizationId, corporateAccountId])
  @@map("corporate_contacts")
}

enum CorporateOccupantStatus {
  ACTIVE
  INACTIVE
  LEFT_COMPANY
}

/// An employee/occupant physically residing in a corporate-leased Unit -
/// deliberately NOT a Renter (see docs/CORPORATE-HOUSING.md, "Corporate
/// Occupant vs Renter"): never a Contract party, Invoice customer, or
/// Payment customer. Status is the employee's own operational state, kept
/// deliberately independent of any CorporateHousingAllocation's own
/// lifecycle (an employee can be ACTIVE with zero current allocation, e.g.
/// between assignments).
model CorporateOccupant {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  corporateAccountId String
  corporateAccount   CorporateAccount @relation(fields: [corporateAccountId], references: [id], onDelete: Cascade)

  employeeNumber String?
  fullName       String
  fullNameAr     String?

  email String?
  phone String?

  nationality String?

  jobTitle   String?
  department String?

  status CorporateOccupantStatus @default(ACTIVE)

  // Deliberately minimal PII (docs/CORPORATE-HOUSING.md, "PII policy") - no
  // passport/national-ID scans, no medical data, no salary, no bank
  // details; only what an operational housing-allocation record needs.
  emergencyContactName  String?
  emergencyContactPhone String?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  allocations           CorporateHousingAllocation[]
  maintenanceRequests   MaintenanceRequest[]
  communicationMessages CommunicationMessage[]

  @@index([organizationId, corporateAccountId, status])
  @@map("corporate_occupants")
}

enum CorporateHousingAllocationStatus {
  PLANNED
  ACTIVE
  ENDED
  CANCELLED
}

/// "This occupant is assigned to this corporate-leased Unit for this
/// period" - deliberately NOT a lease/sublease/financial contract/invoice/
/// payment schedule (docs/CORPORATE-HOUSING.md, "Allocation vs Contract").
/// `contractId`/`unitId` are re-verified consistent
/// (contract.unitId === unitId, contract.renterId === account.renterId,
/// every organizationId matching) by the server on every write - never
/// trusted from a client-supplied combination. Ending/cancelling an
/// allocation never mutates Unit.status, Contract.status, MoveIn, or
/// MoveOut - those remain governed exclusively by their own existing
/// workflows.
model CorporateHousingAllocation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  corporateAccountId String
  corporateAccount   CorporateAccount @relation(fields: [corporateAccountId], references: [id], onDelete: Restrict)

  occupantId String
  occupant   CorporateOccupant @relation(fields: [occupantId], references: [id], onDelete: Restrict)

  contractId String
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Restrict)

  unitId String
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Restrict)

  // "CHA-000001" via the existing Counter infrastructure (key
  // "corporateHousingAllocation") - no year component, matching
  // formatMoveInNumber()/formatMaintenanceRequestNumber()'s own convention.
  allocationNumber String

  startDate      DateTime
  plannedEndDate DateTime?
  actualEndDate  DateTime?

  status CorporateHousingAllocationStatus @default(PLANNED)

  bedroomNumber String?
  roomLabel     String?

  notes String?

  createdByUserId String
  endedByUserId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, allocationNumber])
  @@index([organizationId, corporateAccountId, status])
  @@index([organizationId, occupantId, status])
  @@index([organizationId, contractId, status])
  @@index([organizationId, unitId, status])
  @@index([organizationId, startDate])
  @@index([organizationId, plannedEndDate])
  @@map("corporate_housing_allocations")
}

// =============================================================================
// NOTIFICATIONS & COMMUNICATIONS (Prompt 19) - a centralized, provider-
// agnostic outbound-communications foundation. See
// docs/NOTIFICATIONS-COMMUNICATIONS.md for the full architecture rationale
// (Step 1 audit). Business modules NEVER call an email/WhatsApp provider
// directly - they call enqueueCommunicationEvent() (src/lib/communications/
// enqueue.ts), strictly AFTER their own transaction commits, and a separate
// queue processor (processQueuedCommunications()) does the actual sending
// later. CommunicationMessage is a durable outbox in its own right (no
// separate CommunicationOutboxEvent model exists - see "Outbox Consistency
// Audit" in the docs for why that is a deliberate decision, not an
// oversight). CommunicationMessage/CommunicationDeliveryAttempt are a
// distinct concern from AuditLog and never overload it.
// =============================================================================

enum CommunicationChannel {
  EMAIL
  WHATSAPP
}

/// Centralized business-event vocabulary. Defining a value here only adds it
/// to the registry (src/lib/communications/events.ts) - it does NOT wire up
/// an integration or seed a default Rule/Template. Only the 9 events marked
/// "wired" in that registry have an actual call-site + seeded default Rule;
/// the rest exist so the vocabulary is genuinely centralized from day one
/// without silently auto-enabling every future notification.
enum CommunicationEventType {
  INVOICE_ISSUED
  PAYMENT_RECEIVED
  MAINTENANCE_REQUEST_CREATED
  MAINTENANCE_SCHEDULED
  MAINTENANCE_COMPLETED
  MOVE_IN_SCHEDULED
  MOVE_OUT_SCHEDULED
  SECURITY_DEPOSIT_SETTLEMENT_POSTED
  SECURITY_DEPOSIT_REFUND_RECORDED
  CONTRACT_CREATED
  CONTRACT_RENEWED
  CONTRACT_TERMINATED
  RESERVATION_CONFIRMED
  TENANT_PORTAL_ACCOUNT_INVITED
  OWNER_PORTAL_ACCOUNT_INVITED
  CORPORATE_ALLOCATION_ACTIVATED

  // Automation & Scheduled Jobs (docs/AUTOMATION-SCHEDULED-JOBS.md, Step
  // 27) - emitted only by a scheduled AutomationJob handler, never by a
  // direct business action. Each is wired (COMMUNICATION_EVENT_REGISTRY)
  // but the underlying reminder type itself defaults DISABLED per
  // organization (AutomationSettings) until explicitly turned on.
  RENT_DUE_REMINDER
  CONTRACT_EXPIRY_REMINDER
  MOVE_IN_REMINDER
  MOVE_OUT_REMINDER
}

/// How a CommunicationRule resolves WHO receives a message for its event.
/// Only RENTER is used by the 9 seeded default Rules in V1; the others are
/// implemented in the resolver (src/lib/communications/recipients.ts) and
/// unit-tested, but not wired to any default Rule yet - available for a
/// future Rule to select via the Rule admin UI.
enum CommunicationRecipientStrategy {
  RENTER
  OWNER
  CORPORATE_PRIMARY_CONTACT
  CORPORATE_HOUSING_CONTACT
  ASSIGNED_STAFF
  SPECIFIC_INTERNAL_USER
}

/// The actual resolved party type a CommunicationMessage/CommunicationPreference
/// was generated for - distinct from CommunicationRecipientStrategy (the
/// "how", on a Rule) vs. this (the "who, concretely", on a Message/Preference).
enum CommunicationRecipientType {
  RENTER
  OWNER
  CORPORATE_CONTACT
  CORPORATE_OCCUPANT
  INTERNAL_USER
}

enum CommunicationTemplateStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

/// QUEUED -> PROCESSING -> (SENT -> DELIVERED -> READ) | FAILED, with
/// QUEUED/PROCESSING -> CANCELLED also valid (Critical Principle 4:
/// delivery status is authoritative - a message is never marked SENT merely
/// because it was queued). See isValidStatusTransition() in
/// src/lib/communications/status.ts for the enforced state machine.
enum CommunicationMessageStatus {
  QUEUED
  PROCESSING
  SENT
  DELIVERED
  READ
  FAILED
  CANCELLED
}

/// Minimal on purpose - retryable-vs-permanent classification is a pure
/// function over the provider's normalized error code
/// (classifyProviderError() in src/lib/communications/retry.ts), not baked
/// into this enum.
enum CommunicationDeliveryAttemptStatus {
  SENT
  FAILED
}

/// A specific, versioned rendering of one event+channel+language's message
/// content. Versioned via the existing Counter infrastructure (key
/// `communicationTemplate:${eventType}:${channel}:${language}`), never a
/// racy "max(version)+1" read (see docs/NOTIFICATIONS-COMMUNICATIONS.md,
/// "Template versioning"). Only one ACTIVE version may exist per
/// (organizationId, eventType, channel, language) - enforced by a partial
/// unique index added by hand in the migration (Prisma's schema DSL cannot
/// express a filtered/partial unique index), not by application code alone.
model CommunicationTemplate {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  eventType CommunicationEventType
  channel   CommunicationChannel
  // "en" | "ar" - matches the existing cookie-based Locale convention
  // (src/lib/i18n.ts) rather than introducing a second, conflicting locale
  // enum.
  language  String

  version Int
  status  CommunicationTemplateStatus @default(DRAFT)

  // Email only - null for WhatsApp/other channels with no subject line.
  subject String?

  // The template source, with `{{variableName}}` placeholders - rendered by
  // renderTemplate() (src/lib/communications/render.ts), which HTML-escapes
  // every substituted value and rejects any variable not present in
  // `variables` below (Step 21's "allow-list", never free-form
  // interpolation).
  bodyText String
  // Email only - null for channels with no rich-text body (e.g. WhatsApp,
  // which is send as bodyText per Meta's own template format).
  bodyHtml String?

  // The exhaustive allow-list of `{{variableName}}` placeholders this
  // version's bodyText/bodyHtml/subject may reference - rendering throws if
  // the template contains a placeholder not listed here, or if a required
  // one is missing from the event's payload at render time.
  variables String[]

  createdByUserId   String
  createdByUser     User      @relation("CommunicationTemplateCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  activatedAt       DateTime?
  activatedByUserId String?
  activatedByUser   User?     @relation("CommunicationTemplateActivatedBy", fields: [activatedByUserId], references: [id], onDelete: SetNull)
  archivedAt        DateTime?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages CommunicationMessage[]

  @@unique([organizationId, eventType, channel, language, version])
  @@index([organizationId, eventType, channel, language, status])
  @@map("communication_templates")
}

/// Whether/how one event+channel fires, and who receives it. Multiple Rules
/// may exist for the same (eventType, channel) with different
/// recipientStrategy values (e.g. notify both the Renter and Assigned
/// Staff) - only one Rule per (org, eventType, channel, recipientStrategy)
/// is meaningful, enforced below. A Rule with isEnabled = false never
/// enqueues, even if a matching business event fires (Critical Principle
/// 3/6: nothing sends without an explicit, visible Rule).
model CommunicationRule {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  eventType         CommunicationEventType
  channel           CommunicationChannel
  recipientStrategy CommunicationRecipientStrategy

  // SPECIFIC_INTERNAL_USER strategy only - the fixed User to notify,
  // regardless of the business event's own participants. Null for every
  // other strategy.
  specificUserId String?
  specificUser   User?   @relation("CommunicationRuleSpecificUser", fields: [specificUserId], references: [id], onDelete: SetNull)

  isEnabled Boolean @default(true)

  createdByUserId String
  createdByUser   User   @relation("CommunicationRuleCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, eventType, channel, recipientStrategy])
  @@index([organizationId, eventType, channel, isEnabled])
  @@map("communication_rules")
}

/// One outbound message: the durable "outbox" row itself (Critical
/// Principle 3 - enqueue is the only thing a business transaction's
/// post-commit hook does; everything below happens later, out of band).
/// idempotencyKey DB-enforces Critical Principle 5: the same business event
/// retried (e.g. a page double-submit, a future at-least-once event replay)
/// can never create a second Message for the same
/// (event, business record, channel, recipient).
model CommunicationMessage {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  eventType CommunicationEventType
  channel   CommunicationChannel
  language  String

  status CommunicationMessageStatus @default(QUEUED)

  recipientType       CommunicationRecipientType
  // Exactly one of the five below is set, matching recipientType - typed
  // relations (not a polymorphic recipientId string) for the same
  // referential-integrity reasons documented on
  // MoveOutLiabilityAssessment's own typed source relations above.
  renterId            String?
  renter              Renter?                    @relation(fields: [renterId], references: [id], onDelete: SetNull)
  ownerId             String?
  owner               Owner?                     @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  corporateContactId  String?
  corporateContact    CorporateContact?          @relation(fields: [corporateContactId], references: [id], onDelete: SetNull)
  corporateOccupantId String?
  corporateOccupant   CorporateOccupant?         @relation(fields: [corporateOccupantId], references: [id], onDelete: SetNull)
  internalUserId      String?
  internalUser        User?                      @relation("CommunicationMessageInternalRecipient", fields: [internalUserId], references: [id], onDelete: SetNull)

  // Snapshot of the destination at enqueue time (email address / E.164
  // phone) - never re-read live from the recipient record at send time, so
  // a later profile edit can't silently redirect an already-queued message.
  destinationRaw    String
  // Precomputed masked form (e.g. "j***@example.com", "+9665*****123") for
  // the Communication Center UI - the raw destination is never rendered in
  // any list view (Step 63's privacy/logging requirement).
  destinationMasked String

  templateId      String?
  template        CommunicationTemplate? @relation(fields: [templateId], references: [id], onDelete: Restrict)
  templateVersion Int?

  renderedSubject   String?
  // Frozen rendered output actually sent - independent of any later edit to
  // the Template itself, so message history always reflects what a
  // recipient actually received.
  renderedBody      String
  // The exact variable values used to render this message (audit/debug
  // only - never re-used to re-render, since a manual retry re-renders
  // fresh from the template's current ACTIVE version).
  variablesSnapshot Json

  // Traceability back to the business record that triggered this message
  // (e.g. "Invoice" / <invoiceId>) - reference-only, no FK (the referenced
  // record's own model varies per eventType), never used for
  // authorization.
  businessEntityType String
  businessEntityId   String

  idempotencyKey String

  attemptCount  Int       @default(0)
  maxAttempts   Int       @default(5)
  lastAttemptAt DateTime?
  nextAttemptAt DateTime?

  // Set by the queue processor when it claims this row (via a conditional
  // updateMany(... where: { status: "QUEUED" } ...) - see
  // processQueuedCommunications()) and cleared on completion. A row stuck
  // in PROCESSING past the stuck-processing-recovery threshold (worker
  // crash mid-send) is recovered back to QUEUED by the next processor run.
  claimedAt DateTime?
  claimedBy String?

  sentAt      DateTime?
  deliveredAt DateTime?
  readAt      DateTime?
  failedAt    DateTime?

  cancelledAt       DateTime?
  cancelledByUserId String?
  cancelledByUser   User?     @relation("CommunicationMessageCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: SetNull)

  // Sanitized (no secrets/PII beyond what's already in this row) - the raw
  // provider error, if any, lives only in CommunicationDeliveryAttempt.
  lastErrorCode    String?
  lastErrorMessage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deliveryAttempts CommunicationDeliveryAttempt[]

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, status, nextAttemptAt])
  @@index([organizationId, eventType])
  @@index([organizationId, createdAt])
  @@index([organizationId, businessEntityType, businessEntityId])
  @@map("communication_messages")
}

/// Append-only send-attempt history for one CommunicationMessage - never
/// updated or deleted once created (same convention as AuditLog). Distinct
/// from AuditLog itself (Critical Principle 2): this is delivery mechanics
/// (which provider, which error, when), not a compliance record of a
/// business-state change.
model CommunicationDeliveryAttempt {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  messageId String
  message   CommunicationMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  attemptNumber Int
  status        CommunicationDeliveryAttemptStatus

  // A plain tag ("mock", "resend", "whatchimp", ...) - never a
  // vendor-specific schema leaking into this shared table.
  providerName      String
  providerMessageId String?

  errorCode    String?
  errorMessage String?

  startedAt  DateTime
  finishedAt DateTime

  createdAt DateTime @default(now())

  @@index([organizationId, messageId])
  @@map("communication_delivery_attempts")
}

/// Per-recipient, per-channel opt-out flag. Deliberately keyed by a plain
/// (recipientType, recipientId) pair rather than typed relations like
/// CommunicationMessage above: this table is a low-stakes boolean toggle
/// (a stale row surviving a deleted Renter/Contact is harmless), and a
/// typed-FK composite unique constraint would be unenforceable here anyway
/// (Postgres treats NULLs in the other four nullable FK columns as
/// distinct, so duplicate rows could slip past a unique index). Built for
/// the OPTIONAL classification path (src/lib/communications/events.ts) -
/// all 9 seeded V1 events are TRANSACTIONAL and never consult this table,
/// so it is real but currently inert; see
/// docs/NOTIFICATIONS-COMMUNICATIONS.md, "Preferences & opt-out".
model CommunicationPreference {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  recipientType CommunicationRecipientType
  recipientId   String
  channel       CommunicationChannel

  optedOut        Boolean @default(false)
  updatedByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, recipientType, recipientId, channel])
  @@map("communication_preferences")
}

// ---------------------------------------------------------------------------
// Document Management (docs/DOCUMENT-MANAGEMENT.md)
//
// Business Entity -> DocumentLink -> Document -> DocumentVersion -> Storage
// Adapter -> Authorized Download -> Audit. Metadata and bytes are strictly
// separated (Critical Principle 1): Document/DocumentVersion below store
// only metadata; actual file bytes live behind the DocumentStorageProvider
// abstraction (src/lib/documents/providers/), addressed only by
// DocumentVersion.storageKey - which is never exposed in any client-facing
// payload (Step 67). This deliberately does NOT reuse the
// Organization.logoUrl base64-in-Postgres pattern (that stays a narrowly
// scoped exception - see docs/STORAGE-ARCHITECTURE.md) and deliberately does
// NOT replace or migrate the existing metadata-only MoveInAttachment/
// MoveOutAttachment/MaintenanceAttachment models, which remain fully
// functional and untouched - a Document may additionally be linked to the
// same parent entities those models describe, but this is purely additive
// (Steps 49-51/92-94).
// ---------------------------------------------------------------------------

/// The fixed V1 set of business entities a Document's security context or a
/// DocumentLink may reference (Step 5). Deliberately a plain enum consumed
/// only through the centralized authorization registry
/// (src/lib/documents/entity-registry.ts) - never a scattered per-page
/// switch statement (Step 6).
enum DocumentEntityType {
  RENTER
  OWNER
  CONTRACT
  UNIT
  COMPOUND
  BUILDING
  INVOICE
  PAYMENT
  MAINTENANCE_REQUEST
  MOVE_IN
  MOVE_OUT
  SECURITY_DEPOSIT_SETTLEMENT
  CORPORATE_ACCOUNT
  CORPORATE_OCCUPANT
}

/// Coarse classification for filtering/display only - category never itself
/// grants access (Step 7); actual authorization is always
/// visibility + live entitlement against the security context (Step 10).
enum DocumentCategory {
  CONTRACT
  IDENTITY
  OWNERSHIP_DEED
  BANK_DETAIL
  MOVE_IN_EVIDENCE
  MOVE_OUT_EVIDENCE
  SECURITY_DEPOSIT_EVIDENCE
  MAINTENANCE_EVIDENCE
  PAYMENT_RECEIPT
  CORPORATE_ACCOUNT_DOCUMENT
  BUILDING_PLAN
  GENERAL
  OTHER
}

enum DocumentStatus {
  ACTIVE
  ARCHIVED
}

/// A flag only - never sufficient on its own. Every download/preview still
/// re-runs live entitlement against the security context (Step 9/10); this
/// merely says which portals are even eligible to attempt that check.
enum DocumentVisibility {
  INTERNAL_ONLY
  TENANT_VISIBLE
  OWNER_VISIBLE
}

/// LOCAL_DEV is filesystem-backed, outside any public static directory,
/// explicitly non-production (Step 17). S3_COMPATIBLE is the production
/// adapter boundary - buildable/testable with no real credentials present,
/// remaining disabled/validate-only until AWS/S3-compatible env vars are
/// configured (Step 18) - see src/lib/documents/providers/.
enum StorageProvider {
  LOCAL_DEV
  S3_COMPATIBLE
}

/// Honest placeholder (Step 26): no malware scanning exists in this
/// codebase today. Every version is created NOT_SCANNED and stays that way;
/// the other values exist only so a future real scanner integration has
/// somewhere to write its result without a schema change.
enum DocumentScanStatus {
  NOT_SCANNED
  CLEAN
  BLOCKED
  FAILED
}

/// One Document = one metadata record + version history, secured by exactly
/// ONE authoritative "primary security context" (securityContextEntityType/
/// Id below) - never a set of equally-trusted links (Step 11/12), which
/// would let a caller "confused-deputy" their way in via a secondary
/// relation. Any further entity relations are recorded separately in
/// DocumentLink and are non-authorizing discoverability metadata only.
model Document {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  documentNumber String // DOC-000001 (src/lib/numbering.ts formatDocumentNumber(), Counter key "document")

  title      String
  category   DocumentCategory
  status     DocumentStatus     @default(ACTIVE)
  visibility DocumentVisibility @default(INTERNAL_ONLY)

  // The one authoritative security context (Step 11/12) - deliberately a
  // plain (type, id) pair rather than a typed relation, since the
  // referenced model varies per entityType (same pattern as
  // CommunicationMessage.businessEntityType/Id above). Every authorization
  // decision anywhere in the app resolves against THIS pair, and only this
  // pair, via src/lib/documents/entity-registry.ts.
  securityContextEntityType DocumentEntityType
  securityContextEntityId   String

  // Security-context immutability (Step 73): changeable only via a
  // dedicated, audited action restricted to OWNER/ADMIN
  // (changeDocumentSecurityContext() in src/lib/actions/documents.ts) -
  // never a bare field update. Null until first changed.
  securityContextChangedAt       DateTime?
  securityContextChangedByUserId String?

  // Nullable + a separate unique FK (rather than a computed "max version"
  // read) so the finalize step of the upload flow (Step 27/30) can create
  // the Document row before the first DocumentVersion exists, then flip
  // this pointer as the last, atomic step - see createDocumentWithFile()/
  // addDocumentVersion() for the concurrency-safe update.
  currentVersionId String?          @unique
  currentVersion   DocumentVersion? @relation("DocumentCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)

  createdByUserId String

  archivedAt       DateTime?
  archivedByUserId String?
  restoredAt       DateTime?
  restoredByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions DocumentVersion[] @relation("DocumentVersions")
  links    DocumentLink[]

  @@unique([organizationId, documentNumber])
  @@index([organizationId, status])
  @@index([organizationId, securityContextEntityType, securityContextEntityId])
  @@index([organizationId, category])
  @@index([organizationId, createdAt])
  @@map("documents")
}

/// Immutable once created (Step 5/Critical Principle 5) - a new upload
/// never overwrites or deletes a prior version's row, only adds a new one
/// and re-points Document.currentVersionId. versionNumber starts at 1 and
/// is assigned inside the same transaction as the Counter-style concurrency
/// guard in addDocumentVersion() (Step 14/32) - never a racy "max+1" read.
model DocumentVersion {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  documentId String
  document   Document @relation("DocumentVersions", fields: [documentId], references: [id], onDelete: Cascade)

  versionNumber Int

  // Sanitized display filename (Step 21) - never the literal storage path.
  fileName       String
  mimeType       String
  fileSize       Int
  checksumSha256 String // integrity only (Step 25) - never used for authorization

  storageProvider StorageProvider
  // Opaque, unpredictable, generated key (Step 20) - the sole pointer into
  // the storage adapter. Never rendered in HTML/JSON/URLs/filenames (Step
  // 67); key secrecy is never itself treated as authorization (Step 3/20).
  storageKey      String

  scanStatus DocumentScanStatus @default(NOT_SCANNED)

  uploadedByUserId String
  createdAt        DateTime @default(now())

  currentForDocument Document? @relation("DocumentCurrentVersion")

  @@unique([documentId, versionNumber])
  @@index([organizationId, documentId])
  @@map("document_versions")
}

/// Secondary, NON-authorizing discoverability links only (Step 11/12) - e.g.
/// showing a Contract's Document also on the linked Renter's page. Never
/// consulted by any authorization check; the DB-level unique constraint
/// (Step 72) prevents accidental duplicate identical links from a
/// resubmitted form.
model DocumentLink {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  entityType DocumentEntityType
  entityId   String

  createdByUserId String
  createdAt       DateTime @default(now())

  @@unique([documentId, entityType, entityId])
  @@index([organizationId, entityType, entityId])
  @@map("document_links")
}

// ---------------------------------------------------------------------------
// Automation & Scheduled Jobs (docs/AUTOMATION-SCHEDULED-JOBS.md)
//
// Two deliberately distinct models, not one polymorphic table (Critical
// Principle 2): CommunicationOutboxEvent exists because something ALREADY
// HAPPENED inside a business transaction (Payment received, Invoice issued,
// ...) and must be durably recorded in that SAME transaction (Critical
// Principle 1) - closing the exact crash window Prompt 19 left open
// (business commit -> process crash -> enqueueCommunicationEvent() never
// ran -> no CommunicationMessage ever created). AutomationJob exists
// because TIME arrived (a rent-due reminder window, a contract-expiry
// window, ...) - discovered by a scheduler, executed by a worker, and
// re-checked for eligibility at execution time (a job scheduled when an
// invoice was unpaid must skip silently if it was paid before the job ran).
//
// Neither model ever performs a network/provider call itself and neither
// is a second delivery queue - CommunicationMessage (above) remains the
// only outbound-delivery queue in this codebase. The full chain for a
// critical business event is:
//   business transaction -> CommunicationOutboxEvent (this transaction)
//   -> outbox processor  -> CommunicationMessage
//   -> communication delivery worker -> provider
// and for a scheduled reminder:
//   scheduler -> AutomationJob -> worker/handler -> CommunicationOutboxEvent
//   -> outbox processor -> CommunicationMessage -> delivery worker -> provider
//
// At-least-once, never exactly-once (Critical Principle 3): every claim
// below is a single conditional `updateMany(where: { status: <expected> })`,
// the same atomic-claim idiom `processQueuedCommunications()` already uses
// for CommunicationMessage - two concurrent workers racing for the same row
// can only have one succeed, but a crash between "claimed" and "recorded
// outcome" is recovered (stuck-threshold based, bounded) rather than lost,
// which means a handler/processor MUST be safe to run more than once for
// the same logical unit of work - idempotent DB writes (unique keys below)
// are what make that safe, not a false promise of single delivery.
// ---------------------------------------------------------------------------

enum CommunicationOutboxEventStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

/// Durable intent to eventually create one or more CommunicationMessage rows
/// for a business event - inserted in the SAME database transaction as the
/// business mutation it follows from (see src/lib/automation/outbox-emit.ts,
/// `emitCommunicationEventTx()`). Reuses the existing `CommunicationEventType`
/// enum (never a parallel event vocabulary) and stores just enough safe,
/// already-resolved data (`payloadJson`) to create messages later without
/// re-deriving business state that might have since changed - Step 13's
/// "necessary immutable references/snapshots," the same "resolved by the
/// caller, snapshotted" philosophy `CommunicationMessage.destinationRaw`
/// itself already established (see that model's own doc comment above).
model CommunicationOutboxEvent {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  eventType CommunicationEventType

  // Logical idempotency key, reviewed per event type (Step 5) - never a
  // blind reuse of "the business record's own id" when that record can
  // legitimately re-emit the same event type more than once. See
  // src/lib/automation/outbox-keys.ts for the exact key built per event.
  eventKey String

  payloadVersion Int
  payloadJson    Json

  status CommunicationOutboxEventStatus @default(PENDING)

  // When this event becomes eligible for processing - `now()` for every
  // current call site (nothing schedules a FUTURE outbox event in V1), but
  // modeled explicitly so a retry's backoff delay is expressed the same way
  // AutomationJob's own `availableAt` is, not a second retry vocabulary.
  availableAt DateTime @default(now())

  attemptCount Int @default(0)
  maxAttempts  Int @default(5)

  // Set by the processor when it claims this row (conditional `updateMany`,
  // mirroring `CommunicationMessage.claimedAt`/`claimedBy` exactly) and
  // cleared on completion or recovery. A row stuck PROCESSING past the
  // stuck-threshold (worker crash mid-processing) is recovered back to
  // PENDING by the next processor run - see src/lib/automation/outbox-processor.ts.
  lockedAt DateTime?
  lockedBy String?

  processedAt DateTime?
  failedAt    DateTime?

  lastErrorCode    String?
  lastErrorMessage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One durable intent per (organization, event type, logical occurrence) -
  // the DB-enforced idempotency Step 5 requires. A retried business-action
  // submission or an at-least-once replay collides here instead of creating
  // a duplicate logical event.
  @@unique([organizationId, eventType, eventKey])
  @@index([status, availableAt])
  @@index([organizationId])
  @@map("communication_outbox_events")
}

enum AutomationJobType {
  RENT_DUE_REMINDER
  CONTRACT_EXPIRY_REMINDER
  MOVE_IN_REMINDER
  MOVE_OUT_REMINDER
  MAINTENANCE_SLA_CHECK
  COMMUNICATION_RECONCILIATION
}

enum AutomationJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

/// A durable, time-triggered unit of work discovered by the scheduler and
/// executed by the worker (src/lib/automation/scheduler.ts /
/// src/lib/automation/worker.ts) - never created because something already
/// happened (that is CommunicationOutboxEvent's job, above). Every job type
/// in this codebase is organization-scoped (no system-level/cross-tenant job
/// exists in V1 - see docs/AUTOMATION-SCHEDULED-JOBS.md "Scheduler
/// architecture"), so `organizationId` is deliberately required, not
/// nullable, giving every query in this model a hard multi-tenancy boundary
/// for free.
model AutomationJob {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  jobType AutomationJobType

  // Deterministic logical key reviewed per job type (Step 19) - e.g.
  // "<scheduleId>:<offsetDays>:<dueDate>" for a rent reminder, so a changed
  // due date legitimately produces a new logical reminder rather than
  // colliding with a stale one. See src/lib/automation/job-keys.ts.
  jobKey String

  status AutomationJobStatus @default(PENDING)

  // The time this job's underlying business window occurs (e.g. the
  // reminder's target due/expiry/scheduled date) - informational/sortable,
  // distinct from `availableAt` (when the worker may next attempt it).
  scheduledFor DateTime
  availableAt  DateTime @default(now())

  attemptCount Int @default(0)
  maxAttempts  Int @default(5)

  lockedAt DateTime?
  lockedBy String?

  startedAt   DateTime?
  completedAt DateTime?
  failedAt    DateTime?

  lastErrorCode    String?
  lastErrorMessage String?

  payloadVersion Int  @default(1)
  payloadJson    Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attempts AutomationJobAttempt[]

  // DB-enforced job idempotency (Step 19/81): running the scheduler twice
  // (or two overlapping scheduler invocations) can never insert a second
  // logical job for the same key.
  @@unique([organizationId, jobType, jobKey])
  @@index([status, availableAt])
  @@index([organizationId, jobType])
  @@map("automation_jobs")
}

enum AutomationJobAttemptOutcome {
  COMPLETED
  SKIPPED
  RETRYABLE_FAILURE
  PERMANENT_FAILURE
}

/// Append-only execution history (Step 46) - never mutated once written,
/// only ever inserted. Improves operability (claim debugging, stuck-job
/// investigation, "why did this fail three times") without overloading
/// AutomationJob's own single mutable row with a full history.
model AutomationJobAttempt {
  id    String        @id @default(cuid())
  jobId String
  job   AutomationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  attemptNumber Int
  workerId      String

  startedAt  DateTime
  finishedAt DateTime?

  outcome      AutomationJobAttemptOutcome?
  errorCode    String?
  errorMessage String?

  createdAt DateTime @default(now())

  @@index([jobId])
  @@map("automation_job_attempts")
}

/// Per-organization typed switches (Step 37) - deliberately NOT a generic
/// rule-builder/scripting surface (see the module's own no-feature-creep
/// list). Every tenant-facing reminder defaults OFF (Step 38): deploying
/// this code must never suddenly start emailing every existing tenant.
/// System-reliability jobs (outbox processing, stuck recovery, delivery)
/// are not gated by this table at all - they are operational, not
/// tenant-facing, and are enabled by whether the worker routes are called.
model AutomationSettings {
  id             String       @id @default(cuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  rentReminderEnabled             Boolean @default(false)
  contractExpiryReminderEnabled   Boolean @default(false)
  moveInReminderEnabled           Boolean @default(false)
  moveOutReminderEnabled          Boolean @default(false)
  maintenanceSlaAutomationEnabled Boolean @default(false)

  updatedByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("automation_settings")
}

/// Critical Principle 7 ("no silent automation") - a durable, append-only
/// record of every runAutomationScheduler() invocation, so an operator can
/// answer "did the scheduler run, and when" from the database rather than
/// from ephemeral route-response logs. System-level (no organizationId):
/// one scheduler invocation discovers work across every organization in a
/// single pass (src/lib/automation/scheduler.ts). Never read by any handler
/// or business logic - purely an operational/observability record for the
/// /automation dashboard.
model AutomationSchedulerRun {
  id    String   @id @default(cuid())
  ranAt DateTime @default(now())

  /// The exact RunAutomationSchedulerResult (per-reminder-type created
  /// counts) - kept as-is rather than flattened into columns so a future
  /// reminder type never needs a migration just to be recorded here.
  resultJson Json

  @@index([ranAt])
  @@map("automation_scheduler_runs")
}

/// Login rate limiting (Prompt 23 hardening - Step "login rate limiting",
/// finding V/W). A DB-backed fixed-window counter, deliberately not
/// Redis/an in-memory limiter: this app has no other shared-state
/// infrastructure, and adding one "solely for fashion" for a single V1
/// feature was explicitly rejected in favor of this table - acceptable for
/// V1, with the tradeoffs documented in docs/PRODUCTION-SECURITY.md.
///
/// `bucketKey` is never a raw email/IP - see src/lib/rate-limit.ts's
/// hashRateLimitKey() - so this table never stores anything that is itself
/// PII, only an opaque SHA-256 digest of `${kind}:${principalType}:${value}`.
/// One row per (bucketKey, windowStart) - `checkAndRecordLoginAttempt()`
/// upserts with an atomic `attemptCount: { increment: 1 }`, so two
/// concurrent requests in the same window can never under-count each
/// other (Postgres serializes concurrent upserts on the same unique key).
/// Bounded growth: `windowStart` moves forward every
/// LOGIN_RATE_LIMIT_WINDOW_MS, and stale rows are cheap, narrow, and
/// naturally prunable by `createdAt` from an external maintenance job -
/// this table only ever holds counters, never a login history log (that
/// already exists, unredacted, in `AuditLog`).
model LoginRateLimitEntry {
  id           String   @id @default(cuid())
  bucketKey    String
  windowStart  DateTime
  attemptCount Int      @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([bucketKey, windowStart])
  @@index([windowStart])
  @@map("login_rate_limit_entries")
}

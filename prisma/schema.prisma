// Rental & Tax Invoicing SaaS - Prisma schema
// Multi-tenant: every business record is scoped by organizationId.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Neon (and most serverless-friendly Postgres hosts) give you a pooled
  // connection string for the app at runtime and a direct one for
  // migrations. DIRECT_URL falls back to DATABASE_URL locally where there
  // is only one connection string.
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Tenancy & Identity
// ---------------------------------------------------------------------------

enum SubscriptionPlan {
  TRIAL
  BASIC
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
}

enum UserRole {
  OWNER
  ADMIN
  MANAGER
  ACCOUNTANT
  VIEWER
}

model Organization {
  id                     String             @id @default(cuid())
  name                   String
  nameAr                 String?
  commercialRegistration String?
  vatNumber              String? // 15-digit Saudi VAT registration number
  country                String             @default("SA")
  city                   String?
  district               String?
  street                 String?
  buildingNumber         String?
  postalCode             String?
  additionalNumber       String?
  phone                  String?
  email                  String?
  logoUrl                String?
  subscriptionPlan       SubscriptionPlan   @default(TRIAL)
  subscriptionStatus     SubscriptionStatus @default(ACTIVE)
  trialEndsAt            DateTime?
  lastInvoiceHash        String? // ZATCA chain: hash of the most recently issued invoice ("PIH" seed)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  users              User[]
  properties         Property[]
  renters            Renter[]
  contracts          Contract[]
  invoices           Invoice[]
  payments           Payment[]
  counters           Counter[]
  units              Unit[]
  compounds          Compound[]
  buildings          Building[]
  floors             Floor[]
  owners             Owner[]
  propertyOwnerships PropertyOwnership[]
  ownerLedgerEntries OwnerLedgerEntry[]
  leads              Lead[]
  leadActivities     LeadActivity[]
  viewings           Viewing[]
  leasingOffers      LeasingOffer[]

  @@map("organizations")
}

// Atomic per-organization sequence generator (invoice numbers, ICV, contract numbers...)
model Counter {
  id             String       @id @default(cuid())
  organizationId String
  key            String // e.g. "invoice", "contract"
  value          Int          @default(0)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
  @@map("counters")
}

model User {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  email          String
  passwordHash   String
  role           UserRole     @default(VIEWER)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  assignedLeads    Lead[]         @relation("LeadAssignedTo")
  assignedViewings Viewing[]      @relation("ViewingAssignedTo")
  assignedOffers   LeasingOffer[] @relation("OfferAssignedTo")

  @@unique([organizationId, email])
  @@index([email])
  @@map("users")
}

// ---------------------------------------------------------------------------
// Property hierarchy: Compound -> Building -> Floor -> Unit
//
// Property/Unit.propertyId are the original (flat) model and are DEPRECATED
// but kept indefinitely for backward compatibility - existing Properties and
// the Units created under them keep working unchanged. Every Unit (old and
// new) has a required `floorId` into the new hierarchy: existing rows were
// backfilled with one generated Compound/Building/Floor per Property at
// migration time. New code should read/write the Compound/Building/Floor
// side; Property/propertyId should be treated as legacy-only.
// See docs/PROPERTY-HIERARCHY.md for the full migration/deprecation plan.
// ---------------------------------------------------------------------------

enum PropertyType {
  RESIDENTIAL
  COMMERCIAL
  MIXED
}

enum UnitType {
  APARTMENT
  VILLA
  OFFICE
  SHOP
  WAREHOUSE
  OTHER
}

enum UnitStatus {
  VACANT
  OCCUPIED
  MAINTENANCE
}

/// @deprecated superseded by Compound (see docs/PROPERTY-HIERARCHY.md) - kept for backward compatibility, not removed.
model Property {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  nameAr         String?
  propertyType   PropertyType @default(RESIDENTIAL)
  city           String?
  district       String?
  street         String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  units Unit[]

  @@index([organizationId])
  @@map("properties")
}

enum CompoundStatus {
  PLANNING
  UNDER_CONSTRUCTION
  ACTIVE
  INACTIVE
}

model Compound {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  arabicName     String?
  description    String?
  address        String?
  city           String?
  location       String? // free-text location description (e.g. a landmark), distinct from address/city/lat-lng
  latitude       Decimal?       @db.Decimal(10, 7)
  longitude      Decimal?       @db.Decimal(10, 7)
  ownerName      String?
  managerName    String?
  // Denormalized counters, informational only - the app itself always
  // computes live counts (Prisma _count) for dashboards/reports rather than
  // trusting these, to avoid drift if a future integration writes here
  // directly. See docs/PROPERTY-HIERARCHY.md.
  totalBuildings Int            @default(0)
  totalUnits     Int            @default(0)
  amenities      String?
  status         CompoundStatus @default(ACTIVE)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  buildings          Building[]
  propertyOwnerships PropertyOwnership[]
  ownerLedgerEntries OwnerLedgerEntry[]
  leads              Lead[]

  @@index([organizationId])
  @@map("compounds")
}

model Building {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  compoundId     String
  compound       Compound     @relation(fields: [compoundId], references: [id], onDelete: Cascade)
  code           String?
  name           String
  // Not in the original field list, but every other bilingual data field in
  // this codebase (Property.nameAr, Renter.fullNameAr, ...) has an Arabic
  // counterpart, and the project's standing rule is that all user-facing
  // data must support both languages - see docs/PROPERTY-HIERARCHY.md.
  nameAr         String?
  description    String?
  numberOfFloors Int?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  floors             Floor[]
  propertyOwnerships PropertyOwnership[]

  @@index([organizationId])
  @@index([compoundId])
  @@map("buildings")
}

model Floor {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  buildingId     String
  building       Building     @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  floorNumber    Int
  name           String?
  nameAr         String? // see Building.nameAr note above
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  units Unit[]

  @@unique([buildingId, floorNumber])
  @@index([organizationId])
  @@index([buildingId])
  @@map("floors")
}

model Unit {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Legacy flat link - optional now that every unit hangs off `floor`
  // instead. Kept populated for units created before this migration; new
  // units are not required to set it. See docs/PROPERTY-HIERARCHY.md.
  propertyId     String?
  property       Property?    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  // Canonical location going forward: Unit -> Floor -> Building -> Compound.
  floorId        String
  floor          Floor        @relation(fields: [floorId], references: [id])
  unitNumber     String
  floorLabel     String? // free-text floor description (e.g. "3rd Floor"); renamed from the old `floor` scalar column to free that name for the relation above - same data, no loss
  unitType       UnitType     @default(APARTMENT)
  areaSqm        Decimal?     @db.Decimal(10, 2)
  bedrooms       Int?
  bathrooms      Int?
  status         UnitStatus   @default(VACANT)
  baseRentAmount Decimal      @db.Decimal(12, 2)
  vatApplicable  Boolean      @default(false) // residential leasing is VAT-exempt in KSA; commercial is taxable
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  contracts          Contract[]
  propertyOwnerships PropertyOwnership[]
  ownerLedgerEntries OwnerLedgerEntry[]
  viewingUnits       ViewingUnit[]
  leasingOffers      LeasingOffer[]

  @@index([organizationId])
  @@index([propertyId])
  @@index([floorId])
  @@map("units")
}

// ---------------------------------------------------------------------------
// Renters (tenants of the properties, i.e. the landlord's customers)
// ---------------------------------------------------------------------------

enum IdType {
  NATIONAL_ID
  IQAMA
  COMMERCIAL_REGISTRATION
  PASSPORT
  GCC_ID
}

model Renter {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fullName       String
  fullNameAr     String?
  idType         IdType       @default(NATIONAL_ID)
  idNumber       String?
  vatNumber      String? // populated for B2B renters -> triggers standard tax invoice
  phone          String?
  email          String?
  address        String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  contracts         Contract[]
  invoices          Invoice[]
  payments          Payment[]
  convertedFromLead Lead?

  @@index([organizationId])
  @@map("renters")
}

// ---------------------------------------------------------------------------
// Lease contracts & payment schedules
// ---------------------------------------------------------------------------

enum PaymentFrequency {
  MONTHLY
  QUARTERLY
  SEMI_ANNUAL
  ANNUAL
  ONE_TIME
}

enum ContractStatus {
  DRAFT
  ACTIVE
  EXPIRED
  TERMINATED
  RENEWED // superseded by a follow-on contract for the same unit/renter
}

// How the one-off commission/cleaning fees attach to the payment schedule:
// spread evenly across every rent installment, or billed once as its own
// installment due on the contract start date.
enum ExtraChargesMode {
  ONE_TIME
  SPLIT
}

model Contract {
  id               String           @id @default(cuid())
  organizationId   String
  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contractNumber   String
  unitId           String
  unit             Unit             @relation(fields: [unitId], references: [id])
  renterId         String
  renter           Renter           @relation(fields: [renterId], references: [id])
  startDate        DateTime
  endDate          DateTime
  rentAmount       Decimal          @db.Decimal(12, 2)
  paymentFrequency PaymentFrequency @default(ANNUAL)
  securityDeposit  Decimal?         @db.Decimal(12, 2)
  // Rental agency commission and home-cleaning package: both are optional
  // flat fees on top of rent. Unlike rent (which follows vatApplicable/
  // vatRate and can be VAT-exempt for residential leases), these are
  // distinct services and are always taxed at the standard VAT rate.
  commissionAmount Decimal?         @db.Decimal(12, 2)
  cleaningAmount   Decimal?         @db.Decimal(12, 2)
  extraChargesMode ExtraChargesMode @default(ONE_TIME)
  vatApplicable    Boolean          @default(false)
  vatRate          Decimal          @default(15) @db.Decimal(5, 2)
  status           ContractStatus   @default(DRAFT)
  notes            String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  // Renewal chain: set by renewContract() on both sides at once, purely
  // additive (nullable, so every pre-existing contract is simply
  // unlinked). Lets contract history/audit answer "which contract
  // preceded/replaced this one" without inferring it from status alone.
  renewedFromContractId String?   @unique
  renewedFromContract   Contract? @relation("ContractRenewal", fields: [renewedFromContractId], references: [id])
  renewedIntoContract   Contract? @relation("ContractRenewal")

  paymentSchedules  PaymentSchedule[]
  invoices          Invoice[]
  convertedFromLead Lead?

  @@unique([organizationId, contractNumber])
  @@index([organizationId])
  @@map("contracts")
}

enum ScheduleStatus {
  PENDING
  PARTIALLY_INVOICED // some (but not all) of its components have been invoiced
  INVOICED
  PAID
  PARTIALLY_PAID
  OVERDUE
  CANCELLED
}

model PaymentSchedule {
  id                    String         @id @default(cuid())
  organizationId        String
  contractId            String
  contract              Contract       @relation(fields: [contractId], references: [id], onDelete: Cascade)
  installmentNo         Int
  periodStart           DateTime
  periodEnd             DateTime
  dueDate               DateTime
  rentAmount            Decimal        @default(0) @db.Decimal(12, 2)
  commissionAmount      Decimal        @default(0) @db.Decimal(12, 2)
  cleaningAmount        Decimal        @default(0) @db.Decimal(12, 2)
  securityDepositAmount Decimal        @default(0) @db.Decimal(12, 2)
  amount                Decimal        @db.Decimal(12, 2)
  status                ScheduleStatus @default(PENDING)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  invoiceLines InvoiceLine[]

  @@index([organizationId])
  @@index([contractId])
  @@index([status])
  @@map("payment_schedules")
}

// ---------------------------------------------------------------------------
// Tax invoices (ZATCA-aligned) & payments
// ---------------------------------------------------------------------------

enum InvoiceDocumentType {
  TAX_INVOICE
  CREDIT_NOTE
  DEBIT_NOTE
}

// ZATCA invoice subtype: standard (B2B, cleared) vs simplified (B2C, reported)
enum InvoiceKind {
  STANDARD
  SIMPLIFIED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum ZatcaSubmissionStatus {
  NOT_SUBMITTED
  PENDING
  CLEARED
  REPORTED
  REJECTED
}

model Invoice {
  id                  String                @id @default(cuid())
  organizationId      String
  organization        Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoiceNumber       String // human readable, e.g. INV-2026-000123
  icv                 Int // Invoice Counter Value: strictly increasing per organization, never reused
  uuid                String                @unique // ZATCA invoice UUID
  documentType        InvoiceDocumentType   @default(TAX_INVOICE)
  kind                InvoiceKind           @default(SIMPLIFIED)
  contractId          String?
  contract            Contract?             @relation(fields: [contractId], references: [id])
  renterId            String
  renter              Renter                @relation(fields: [renterId], references: [id])
  issueDate           DateTime              @default(now())
  supplyDate          DateTime              @default(now())
  dueDate             DateTime?
  currency            String                @default("SAR")
  subtotal            Decimal               @db.Decimal(12, 2)
  vatAmount           Decimal               @db.Decimal(12, 2)
  totalAmount         Decimal               @db.Decimal(12, 2)
  paidAmount          Decimal               @default(0) @db.Decimal(12, 2)
  status              InvoiceStatus         @default(ISSUED)
  previousInvoiceHash String? // PIH: hash of the prior invoice in the chain (base64 SHA-256)
  invoiceHash         String? // hash of this invoice's canonical content (base64 SHA-256)
  qrCodeBase64        String? // ZATCA TLV-encoded QR payload, base64
  zatcaStatus         ZatcaSubmissionStatus @default(NOT_SUBMITTED)
  zatcaResponse       Json?
  notes               String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  lines    InvoiceLine[]
  payments Payment[]

  @@unique([organizationId, invoiceNumber])
  @@unique([organizationId, icv])
  @@index([organizationId])
  @@index([renterId])
  @@map("invoices")
}

enum InvoiceLineKind {
  RENT
  COMMISSION
  CLEANING
  SECURITY_DEPOSIT
  OTHER
}

model InvoiceLine {
  id                String          @id @default(cuid())
  invoiceId         String
  invoice           Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  // Which schedule installment this line bills, and which component of it -
  // lets one schedule be invoiced across several separate invoices (e.g.
  // rent now, commission later), and lets the schedule's fulfilled status
  // be computed by summing lines per kind. Null for lines not tied to a
  // schedule (shouldn't happen via the current UI, but kept optional for
  // flexibility).
  paymentScheduleId String?
  kind              InvoiceLineKind @default(OTHER)
  description       String
  descriptionAr     String?
  periodStart       DateTime?
  periodEnd         DateTime?
  quantity          Decimal         @default(1) @db.Decimal(10, 2)
  unitPrice         Decimal         @db.Decimal(12, 2)
  discount          Decimal         @default(0) @db.Decimal(12, 2)
  vatRate           Decimal         @default(15) @db.Decimal(5, 2)
  vatAmount         Decimal         @db.Decimal(12, 2)
  lineTotal         Decimal         @db.Decimal(12, 2)

  paymentSchedule PaymentSchedule? @relation(fields: [paymentScheduleId], references: [id])

  @@index([paymentScheduleId])
  @@map("invoice_lines")
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CHEQUE
  CARD
  ONLINE
}

enum PaymentStatus {
  POSTED
  REVERSED
}

/// Payments are never hard-deleted or edited after posting. A correction is
/// made by reversePayment(), which posts a NEW row with a NEGATIVE `amount`
/// (so every existing report/statement that does SUM(amount) nets out
/// correctly with no query changes) and flips the original to `REVERSED` -
/// the original row itself is never touched otherwise. See
/// docs/AUDIT-AND-FINANCIAL-CONTROLS.md, "Payment reversal decision".
model Payment {
  id              String        @id @default(cuid())
  organizationId  String
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoiceId       String
  invoice         Invoice       @relation(fields: [invoiceId], references: [id])
  renterId        String
  renter          Renter        @relation(fields: [renterId], references: [id])
  receiptNumber   String
  amount          Decimal       @db.Decimal(12, 2)
  paymentDate     DateTime      @default(now())
  method          PaymentMethod @default(BANK_TRANSFER)
  referenceNumber String?
  notes           String?
  status          PaymentStatus @default(POSTED)
  createdAt       DateTime      @default(now())

  reversalOfPaymentId String?  @unique
  reversalOfPayment   Payment? @relation("PaymentReversal", fields: [reversalOfPaymentId], references: [id])
  reversedByPayment   Payment? @relation("PaymentReversal")

  @@unique([organizationId, receiptNumber])
  @@index([organizationId])
  @@index([invoiceId])
  @@map("payments")
}

// ---------------------------------------------------------------------------
// Ownership & owner accounting foundation
//
// This is the internal ownership/accounting layer only - there is no owner
// login or self-service portal yet (see docs/OWNERSHIP-ACCOUNTING.md for the
// future Owner Portal design considerations). It is purely additive: no
// existing Contract/Invoice/Payment/PaymentSchedule row or field is touched,
// and no historical financial data is auto-migrated into it. Existing
// compounds/buildings/units may simply have no ownership configured yet.
// ---------------------------------------------------------------------------

enum OwnerType {
  INDIVIDUAL
  COMPANY
  FUND
  GOVERNMENT_ENTITY
  OTHER
}

enum OwnerStatus {
  ACTIVE
  INACTIVE
}

/// An individual, company, investment fund, or government entity that owns
/// (all or part of) a Compound/Building/Unit. Not a User - owners do not log
/// in (no portal yet). Soft-deleted via `deletedAt`; `status` is a separate,
/// reversible "deactivated" flag distinct from deletion.
model Owner {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  ownerType OwnerType @default(INDIVIDUAL)

  name   String
  nameAr String?

  // Identity - only the fields relevant to ownerType are expected to be
  // filled in; none are required at the schema level since which ID applies
  // depends on ownerType (individual vs. company/fund).
  nationalId                String?
  iqamaNumber               String?
  passportNumber            String?
  companyRegistrationNumber String?
  vatNumber                 String?

  email           String?
  mobile          String?
  alternateMobile String?

  address String?
  city    String?
  country String? @default("SA")

  // Banking details - sensitive; not included in list views, only the owner
  // profile/edit screens (see docs/OWNERSHIP-ACCOUNTING.md, "sensitive
  // fields" note).
  bankName        String?
  bankAccountName String?
  iban            String?

  notes  String?
  status OwnerStatus @default(ACTIVE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  // Acting user id at creation/last-update time, for auditability. Not a
  // foreign key on purpose - an audit trail must survive a User being
  // removed in the future, and this codebase has no user-delete flow today
  // anyway, so a hard FK would add constraint risk for no present benefit.
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  ownerships    PropertyOwnership[]
  ledgerEntries OwnerLedgerEntry[]

  @@index([organizationId])
  @@index([organizationId, deletedAt])
  @@map("owners")
}

enum OwnershipStatus {
  ACTIVE
  ENDED
}

/// Assigns an Owner (at a percentage) to exactly one level of the property
/// hierarchy - a Compound, a Building, or a Unit. Deliberately NOT a single
/// ownerId column on Unit: a unit's effective owner(s) are resolved at read
/// time by walking Unit -> Building -> Compound and taking the closest level
/// that has an active ownership record (see getEffectiveOwners() in
/// src/lib/ownership.ts and docs/OWNERSHIP-ACCOUNTING.md, "Ownership
/// inheritance"). This means a compound-wide ownership assignment is never
/// duplicated onto every one of its units.
model PropertyOwnership {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  ownerId String
  owner   Owner  @relation(fields: [ownerId], references: [id])

  // Exactly one of these three should be set per record (enforced in the
  // service layer; a DB-level CHECK constraint requiring at least one is
  // added by the migration as defense in depth - see migration.sql).
  compoundId String?
  compound   Compound? @relation(fields: [compoundId], references: [id], onDelete: Cascade)
  buildingId String?
  building   Building? @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  unitId     String?
  unit       Unit?     @relation(fields: [unitId], references: [id], onDelete: Cascade)

  // 0.00-100.00. The sum of ACTIVE ownershipPercentage values for the exact
  // same asset (same compoundId/buildingId/unitId triple) must never exceed
  // 100 - enforced in src/lib/actions/ownership.ts before every insert.
  ownershipPercentage Decimal @db.Decimal(5, 2)

  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?

  status OwnershipStatus @default(ACTIVE)
  notes  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  @@index([organizationId])
  @@index([ownerId])
  @@index([compoundId])
  @@index([buildingId])
  @@index([unitId])
  @@map("property_ownerships")
}

/// Extensible - see docs/OWNERSHIP-ACCOUNTING.md for the debit/credit
/// convention each type follows (income/contribution = credit,
/// expense/distribution = debit).
enum OwnerLedgerEntryType {
  RENT_INCOME
  OTHER_INCOME
  MANAGEMENT_FEE
  MAINTENANCE_EXPENSE
  UTILITY_EXPENSE
  SERVICE_EXPENSE
  GOVERNMENT_FEE
  OTHER_EXPENSE
  OWNER_CONTRIBUTION
  OWNER_DISTRIBUTION
  ADJUSTMENT
  REVERSAL
}

/// Immutable append-only ledger: there is deliberately no update/delete
/// server action for this model anywhere in the codebase. A posted entry is
/// corrected only by posting a REVERSAL entry that mirrors it (debit/credit
/// swapped) via reverseLedgerEntry() - see src/lib/actions/owner-ledger.ts.
model OwnerLedgerEntry {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  ownerId String
  owner   Owner  @relation(fields: [ownerId], references: [id])

  entryType OwnerLedgerEntryType

  // Free-text pointer to what generated this entry (e.g. "MANUAL",
  // "ALLOCATION"), not a Prisma relation - this ledger must stay postable
  // even for sources that aren't (yet) their own model, and must never be
  // able to cascade-delete a financial record.
  referenceType String?
  referenceId   String?

  description   String
  descriptionAr String?

  debit  Decimal @default(0) @db.Decimal(12, 2)
  credit Decimal @default(0) @db.Decimal(12, 2)

  entryDate DateTime @default(now())

  compoundId String?
  compound   Compound? @relation(fields: [compoundId], references: [id])
  unitId     String?
  unit       Unit?     @relation(fields: [unitId], references: [id])

  // Reversal linkage: set on the REVERSAL entry (points back at what it
  // reverses) and on the original entry (points forward, so it can't be
  // reversed twice). Both unique - a one-to-one pairing.
  reversalOfEntryId String?           @unique
  reversalOfEntry   OwnerLedgerEntry? @relation("LedgerReversal", fields: [reversalOfEntryId], references: [id])
  reversedByEntry   OwnerLedgerEntry? @relation("LedgerReversal")

  createdBy String?
  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([ownerId])
  @@index([entryDate])
  @@map("owner_ledger_entries")
}

// ---------------------------------------------------------------------------
// Audit log
//
// Immutable, append-only, system-written-only record of every mutating
// action across the app. No update/delete server action exists for this
// model anywhere in the codebase, and there is deliberately no `updatedAt`
// or `deletedAt` column - a row is written once and never touched again.
// See docs/AUDIT-AND-FINANCIAL-CONTROLS.md.
//
// organizationId/userId/userEmail/userRole are plain denormalized fields,
// NOT Prisma relations - on purpose, mirroring Owner.createdBy/updatedBy in
// this schema: an audit trail must remain queryable and intact even if the
// Organization or User it refers to is later deleted, renamed, or has its
// role changed. `action`/`entityType` are plain strings (not Prisma enums)
// so a new audited action never requires a schema migration - type safety
// for both is enforced at the application layer instead, in src/lib/audit.ts.
// ---------------------------------------------------------------------------

model AuditLog {
  id             String @id @default(cuid())
  organizationId String

  userId    String?
  userEmail String?
  userRole  String?

  action String

  entityType String
  entityId   String

  entityDisplayName String?

  // Only the fields that actually changed (for UPDATE), or the relevant
  // created/deleted state (for CREATE/DELETE) - never a full raw row dump.
  // Redacted per src/lib/audit.ts's REDACTED_FIELDS/MASKED_FIELDS before
  // being written; see docs/AUDIT-AND-FINANCIAL-CONTROLS.md, "Redaction".
  previousValues Json?
  newValues      Json?

  // Free-form extra context (e.g. { reason, denialReason, attemptedEmail }) -
  // used by permission-denial and login events, which have no entity row.
  metadata Json?

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([organizationId, entityType, entityId])
  @@index([organizationId, action])
  @@index([userId])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// CRM: Leads
//
// A Lead is a prospective residential/corporate tenant BEFORE a lease
// exists - it deliberately does not reuse or extend the `Renter` model
// (Renter is a contracted tenancy entity used throughout invoicing/
// payments/statements). A Lead becomes a Renter only through the explicit
// convertLeadToRenter() workflow (see docs/CRM-LEADS.md); the Lead row is
// never deleted by conversion, only linked via `convertedRenterId` and
// moved to WON, so its full pipeline history stays intact.
//
// This is the Lead + Qualification + pipeline foundation only - Viewings,
// Offers, Reservations, and automatic Contract creation are a future task
// (see docs/CRM-LEADS.md, "Future Viewing/Offer/Reservation architecture").
// ---------------------------------------------------------------------------

enum LeadType {
  INDIVIDUAL
  CORPORATE
  AGENT_REFERRAL
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  VIEWING_PENDING // reserved for the future Viewing module - not settable by any action in this task
  VIEWING_COMPLETED // reserved for the future Viewing module - not settable by any action in this task
  OFFER_PENDING // reserved for the future Offer module - not settable by any action in this task
  NEGOTIATION // reserved for the future Offer module - not settable by any action in this task
  RESERVATION_PENDING // reserved for the future Reservation module - not settable by any action in this task
  WON
  LOST
  ARCHIVED
}

enum LeadSource {
  FACEBOOK
  INSTAGRAM
  GOOGLE
  WHATSAPP
  WEBSITE
  REFERRAL
  WALK_IN
  CORPORATE
  AGENT
  PHONE
  OTHER
}

enum FurnishingPreference {
  FURNISHED
  SEMI_FURNISHED
  UNFURNISHED
  FLEXIBLE
}

enum LeadLostReason {
  PRICE
  NO_AVAILABILITY
  LOCATION
  COMPETITOR
  NO_RESPONSE
  BUDGET
  TIMING
  CUSTOMER_CANCELLED
  OTHER
}

enum LeadActivityType {
  CALL
  WHATSAPP
  EMAIL
  MEETING
  NOTE
  FOLLOW_UP
  STATUS_CHANGE
  OTHER
}

model Lead {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  leadNumber String // e.g. "LEAD-000001" - sequential per organization via the existing Counter infrastructure (key "lead"), never a separate numbering scheme

  leadType LeadType   @default(INDIVIDUAL)
  status   LeadStatus @default(NEW)

  // Individual/agent-referral contact identity. For CORPORATE leads these
  // hold the case contact's name (mirrored into contactPerson* below for
  // clarity); `fullName` is always kept in sync (by the server action, not
  // a DB trigger) as the single display name used across list/search UI -
  // "first last" for individuals, `companyName` for corporate leads.
  firstName String?
  lastName  String?
  fullName  String

  mobile           String
  // Normalized (digits only, country-code-canonicalized) form of `mobile`,
  // computed by src/lib/crm/phone.ts at write time - used for duplicate
  // detection and the organizationId+normalizedMobile index. `mobile`
  // itself keeps the original, user-entered display value.
  normalizedMobile String
  alternateMobile  String?
  email            String?

  nationality String?

  employer String?
  jobTitle String?

  // Also used as the primary company identity for CORPORATE leads.
  companyName String?

  // CORPORATE-only fields (see docs/CRM-LEADS.md, "Corporate leads") - this
  // is deliberately NOT a separate Corporate Client model yet, just the
  // additional fields a corporate housing enquiry needs on the Lead itself.
  contactPersonName   String?
  contactPersonMobile String?
  contactPersonEmail  String?
  employeeCount       Int?
  requiredUnits       Int?
  requestedCity       String?
  projectName         String?
  housingStartDate    DateTime?
  housingEndDate      DateTime?

  familySize Int?

  budgetMin Decimal? @db.Decimal(12, 2)
  budgetMax Decimal? @db.Decimal(12, 2)

  preferredBedrooms Int?
  // Reuses the existing UnitType enum (see Unit model) rather than a new
  // CRM-specific one - a lead's unit-type preference and a real unit's
  // type are the same concept.
  preferredUnitType UnitType?

  preferredCompoundId String?
  preferredCompound   Compound? @relation(fields: [preferredCompoundId], references: [id], onDelete: SetNull)

  moveInDate          DateTime?
  leaseDurationMonths Int?
  furnishedPreference FurnishingPreference?

  notes String?

  source LeadSource @default(OTHER)

  // Live operational assignment (unlike createdByUserId below, this is a
  // real relation: the UI needs to join/display/reassign it, and it must
  // be verified to belong to the same organization on every write).
  assignedToUserId String?
  assignedToUser   User?   @relation("LeadAssignedTo", fields: [assignedToUserId], references: [id], onDelete: SetNull)

  // Plain string, not a relation - mirrors Owner.createdBy/updatedBy: an
  // audit-adjacent attribution field that must survive a User being
  // removed, not a live join target.
  createdByUserId String

  convertedRenterId String? @unique
  convertedRenter   Renter? @relation(fields: [convertedRenterId], references: [id], onDelete: SetNull)

  // Reserved for the future Contract-conversion step (not implemented in
  // this task) - present now so the column exists additively rather than
  // requiring another migration when that workflow is built.
  convertedContractId String?   @unique
  convertedContract   Contract? @relation(fields: [convertedContractId], references: [id], onDelete: SetNull)

  lostReason     LeadLostReason?
  lostReasonNote String?

  lastContactAt  DateTime?
  nextFollowUpAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activities    LeadActivity[]
  viewings      Viewing[]
  leasingOffers LeasingOffer[]

  @@unique([organizationId, leadNumber])
  @@index([organizationId, status])
  @@index([organizationId, normalizedMobile])
  @@index([organizationId, assignedToUserId])
  @@index([organizationId, nextFollowUpAt])
  @@index([organizationId, source])
  @@index([organizationId, createdAt])
  @@map("leads")
}

/// Business interaction history (calls, WhatsApp, meetings, notes, follow-
/// ups) - append-only by convention (no update/delete action exists), but
/// distinct from AuditLog: LeadActivity is what leasing staff did with a
/// prospect, AuditLog is the system/security record of what changed and
/// who has access. See docs/CRM-LEADS.md, "LeadActivity vs AuditLog".
model LeadActivity {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leadId         String
  lead           Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)

  activityType LeadActivityType

  subject String?
  notes   String?

  activityDate DateTime @default(now())

  // Plain string (never client-supplied - see src/lib/actions/lead-
  // activities.ts) - same attribution pattern as Lead.createdByUserId.
  createdByUserId String
  createdAt       DateTime @default(now())

  @@index([organizationId, leadId])
  @@index([organizationId, activityDate])
  @@map("lead_activities")
}

// ---------------------------------------------------------------------------
// CRM: Viewing Management
//
// A Viewing is a scheduled visit by a Lead to one or more Units. This is
// purely additive on top of the Lead/LeadActivity/Unit models - none of
// them are redesigned. Scope is deliberately Viewing-only: the future
// Offer/Reservation steps (Lead -> Viewing -> Offer -> Reservation ->
// Contract) are not implemented here - see docs/VIEWING-MANAGEMENT.md,
// "Future Offer/Reservation integration".
// ---------------------------------------------------------------------------

enum ViewingStatus {
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
  RESCHEDULED // transient: set briefly by rescheduleViewing() and immediately moved back to SCHEDULED/CONFIRMED in the same transaction - see docs/VIEWING-MANAGEMENT.md, "Rescheduling"
}

enum ViewingOutcome {
  INTERESTED
  FOLLOW_UP_REQUIRED
  NOT_INTERESTED
  OFFER_REQUESTED
  RESERVATION_REQUESTED
  OTHER
}

enum ViewingCancelReason {
  CUSTOMER_REQUEST
  AGENT_UNAVAILABLE
  UNIT_UNAVAILABLE
  RESCHEDULED
  NO_RESPONSE
  OTHER
}

model Viewing {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  viewingNumber String // e.g. "VIEW-000001" - sequential per organization via the existing Counter infrastructure (key "viewing"), never a separate numbering scheme

  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  // Live operational assignment - same pattern as Lead.assignedToUserId:
  // a real relation (not a plain string), verified same-organization on
  // every write, since the UI joins/displays/reassigns it constantly.
  assignedToUserId String?
  assignedToUser   User?   @relation("ViewingAssignedTo", fields: [assignedToUserId], references: [id], onDelete: SetNull)

  scheduledStart DateTime
  scheduledEnd   DateTime

  status ViewingStatus @default(SCHEDULED)

  customerNotes String?
  internalNotes String?

  feedbackSummary String?
  outcome         ViewingOutcome?

  cancelReason     ViewingCancelReason?
  cancelReasonNote String?

  completedAt DateTime?

  // Plain string, not a relation - mirrors Lead.createdByUserId: survives
  // a User being removed, not a live join target.
  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  units         ViewingUnit[]
  leasingOffers LeasingOffer[]

  @@unique([organizationId, viewingNumber])
  @@index([organizationId, scheduledStart])
  @@index([organizationId, assignedToUserId, scheduledStart])
  @@index([organizationId, leadId])
  @@index([organizationId, status])
  @@map("viewings")
}

/// Join table: a Viewing may cover more than one Unit (e.g. touring two
/// comparable apartments back-to-back). Deliberately thin - no Unit data
/// is duplicated here, only the linkage plus per-unit sequence/notes.
model ViewingUnit {
  id             String @id @default(cuid())
  organizationId String

  viewingId String
  viewing   Viewing @relation(fields: [viewingId], references: [id], onDelete: Cascade)

  unitId String
  unit   Unit   @relation(fields: [unitId], references: [id])

  sequence Int     @default(1)
  notes    String?

  createdAt DateTime @default(now())

  @@unique([viewingId, unitId])
  @@index([organizationId, unitId])
  @@map("viewing_units")
}

// ---------------------------------------------------------------------------
// CRM: Leasing Offer Management
//
// A LeasingOffer is a commercial pre-contract proposal: Lead -> (optional)
// Viewing -> Offer -> Negotiation -> future Reservation -> future Contract.
// Purely additive on top of Lead/Viewing/Unit - none of them are redesigned,
// and this task deliberately stops short of Reservations/Contract
// conversion - see docs/LEASING-OFFERS.md, "Future Reservation/Contract
// integration". Offer calculations are commercial/pre-contract data only:
// no Invoice/PaymentSchedule/Payment/OwnerLedgerEntry row is ever created by
// any action in this file.
// ---------------------------------------------------------------------------

enum OfferStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SENT
  UNDER_NEGOTIATION
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
  SUPERSEDED // superseded by a newer revision in the same offerNumber chain - see reviseOffer()
}

/// Deliberately separate from OfferStatus (Step 12 of the brief): internal
/// discount-approval sign-off and the customer's own accept/reject decision
/// are different concepts and must never be conflated in one enum. See
/// docs/LEASING-OFFERS.md, "Approval rules".
enum ApprovalStatus {
  NOT_REQUIRED
  PENDING
  APPROVED
  REJECTED
}

/// The customer's own reason for declining an offer - distinct from
/// LeadLostReason (a Lead can be rejected on this Offer without ever being
/// marked LOST, see docs/LEASING-OFFERS.md, "Lead status integration").
enum OfferRejectReason {
  PRICE
  PAYMENT_TERMS
  UNIT
  LOCATION
  TIMING
  COMPETITOR
  CUSTOMER_CANCELLED
  OTHER
}

model LeasingOffer {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Stable across an entire revision chain (Step 11) - e.g. "OFFER-000001"
  // via the existing Counter infrastructure (key "offer"), allocated only
  // once per chain (on the first version); revisions copy it rather than
  // drawing a new sequence value. `versionNumber` is the only thing that
  // increments per revision - see reviseOffer() in src/lib/actions/offers.ts.
  offerNumber   String
  versionNumber Int    @default(1)

  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  // Optional - Step 10 requires a direct Offer from a qualified Lead to
  // remain possible without ever having gone through a Viewing.
  viewingId String?
  viewing   Viewing? @relation(fields: [viewingId], references: [id], onDelete: SetNull)

  // Single primary Unit only (Step 3) - schema is additive-friendly for a
  // future OfferUnit join table (corporate multi-unit), not implemented here.
  unitId String
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Restrict)

  status         OfferStatus    @default(DRAFT)
  approvalStatus ApprovalStatus @default(NOT_REQUIRED)

  validFrom  DateTime
  validUntil DateTime

  currency String @default("SAR")

  // Pricing - see src/lib/crm/offer-pricing.ts for the pure calculation
  // this row's stored values are derived from. Rent itself carries no VAT
  // at Offer stage (matching Contract.vatApplicable defaulting to false for
  // residential leasing); only the leasing commission is taxed, mirroring
  // EXTRA_CHARGE_VAT_RATE in src/lib/actions/invoices.ts.
  annualRent         Decimal @db.Decimal(12, 2)
  discountAmount     Decimal @default(0) @db.Decimal(12, 2)
  discountPercentage Decimal @default(0) @db.Decimal(5, 2)
  netAnnualRent      Decimal @db.Decimal(12, 2)

  securityDeposit Decimal @db.Decimal(12, 2)
  contractFee     Decimal @default(0) @db.Decimal(12, 2)

  leasingCommissionAmount Decimal  @default(0) @db.Decimal(12, 2)
  leasingCommissionRate   Decimal? @db.Decimal(5, 2)
  commissionVatRate       Decimal  @default(15) @db.Decimal(5, 2)
  commissionVatAmount     Decimal  @default(0) @db.Decimal(12, 2)

  totalInitialPayment Decimal @db.Decimal(12, 2)

  paymentFrequency PaymentFrequency @default(ANNUAL)

  leaseStartDate      DateTime?
  leaseDurationMonths Int       @default(12)

  furnishedStatus FurnishingPreference @default(UNFURNISHED)

  specialTerms  String?
  internalNotes String?

  sentAt     DateTime?
  acceptedAt DateTime?
  rejectedAt DateTime?
  expiredAt  DateTime?

  rejectReason     OfferRejectReason?
  rejectReasonNote String?

  // Plain string, not a relation - mirrors Lead.createdByUserId/
  // Viewing.createdByUserId: survives a User being removed.
  createdByUserId String

  // Live operational assignment - same pattern as Lead/Viewing's
  // assignedToUserId: a real relation, verified same-organization on every
  // write.
  assignedToUserId String?
  assignedToUser   User?   @relation("OfferAssignedTo", fields: [assignedToUserId], references: [id], onDelete: SetNull)

  // Revision chain (Step 11/32): unique so exactly one child can ever point
  // at a given parent, keeping the chain linear - mirrors
  // Contract.renewedFromContractId. Set only by reviseOffer(), which also
  // flips the parent's status to SUPERSEDED in the same transaction.
  parentOfferId String?       @unique
  parentOffer   LeasingOffer? @relation("OfferRevision", fields: [parentOfferId], references: [id], onDelete: SetNull)
  revisedInto   LeasingOffer? @relation("OfferRevision")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, offerNumber, versionNumber])
  @@index([organizationId, status])
  @@index([organizationId, leadId])
  @@index([organizationId, unitId])
  @@index([organizationId, assignedToUserId])
  @@index([organizationId, validUntil])
  @@index([organizationId, createdAt])
  @@index([organizationId, offerNumber])
  @@map("leasing_offers")
}

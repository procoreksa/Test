# Local Postgres: use the same URL for both. On Neon: DATABASE_URL is the
# pooled connection string (used at runtime), DIRECT_URL is the direct one
# (used only for migrations).
DATABASE_URL="postgresql://app_user:app_password@localhost:5432/rental_saas?schema=public"
DIRECT_URL="postgresql://app_user:app_password@localhost:5432/rental_saas?schema=public"
AUTH_SECRET="replace-with-a-random-32-byte-secret"
# Do NOT set NEXTAUTH_URL / AUTH_URL: the app has trustHost enabled and
# derives the correct origin from each request's headers. Hardcoding this
# (e.g. leftover "http://localhost:3000" on a deployed host) sends
# post-login redirects to the wrong URL.

# ZATCA (Saudi VAT e-invoicing) - Fatoora integration, optional until you onboard.
ZATCA_ENVIRONMENT="sandbox"
ZATCA_API_BASE_URL="https://gw-fatoora.zatca.gov.sa/e-invoicing/developer-portal"
ZATCA_ONBOARDING_OTP=""

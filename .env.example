# Local Postgres: use the same URL for both. On Neon: DATABASE_URL is the
# pooled connection string (used at runtime), DIRECT_URL is the direct one
# (used only for migrations).
DATABASE_URL="postgresql://app_user:app_password@localhost:5432/rental_saas?schema=public"
DIRECT_URL="postgresql://app_user:app_password@localhost:5432/rental_saas?schema=public"
AUTH_SECRET="replace-with-a-random-32-byte-secret"
# Gates POST /api/communications/process (the notification queue worker
# route) - a separate secret from AUTH_SECRET since it triggers real
# provider sends once a real provider is configured, a materially
# different blast radius than the demo-seed route. An external
# cron/scheduled-task caller hits this endpoint periodically; nothing in
# this codebase calls it on its own (see docs/NOTIFICATIONS-COMMUNICATIONS.md,
# "Scheduling boundary").
COMMUNICATIONS_WORKER_SECRET="replace-with-a-random-32-byte-secret"
# Gates POST /api/automation/scheduler, /api/automation/worker, and
# /api/automation/outbox - the three automation stages (discover jobs,
# execute jobs, drain the communication outbox). Deliberately a separate
# secret from COMMUNICATIONS_WORKER_SECRET so each stage's exposure is
# independently rotatable (see docs/AUTOMATION-SCHEDULED-JOBS.md,
# "Production runbook - secret rotation"). An external cron/scheduled-task
# caller hits each endpoint periodically at its own cadence.
AUTOMATION_WORKER_SECRET="replace-with-a-random-32-byte-secret"
# Do NOT set NEXTAUTH_URL / AUTH_URL: the app has trustHost enabled and
# derives the correct origin from each request's headers. Hardcoding this
# (e.g. leftover "http://localhost:3000" on a deployed host) sends
# post-login redirects to the wrong URL.

# Optional - a wholly independent signing secret for the Owner Portal's
# NextAuth instance. If unset, derived from AUTH_SECRET (never equal to
# it) - see src/lib/owner-auth.ts. Set explicitly in production for full
# secret independence between principals.
OWNER_AUTH_SECRET=""
# Same idea for the Tenant Portal - see src/lib/tenant-auth.ts.
TENANT_AUTH_SECRET=""

# Production storage (Prompt 23 hardening - Critical Rule 5). Production
# MUST NOT run on the LOCAL_DEV filesystem adapter (src/instrumentation.ts
# fails closed if NODE_ENV=production and these are not all five set) -
# see docs/PRODUCTION-DEPLOYMENT.md, "Object storage". Works against real
# AWS S3 or any S3-compatible provider (Cloudflare R2, MinIO, Backblaze
# B2, Supabase Storage) via a custom endpoint.
DOCUMENT_S3_ENDPOINT=""
DOCUMENT_S3_REGION=""
DOCUMENT_S3_BUCKET=""
DOCUMENT_S3_ACCESS_KEY_ID=""
DOCUMENT_S3_SECRET_ACCESS_KEY=""
# Optional - defaults to "true" (path-style addressing, required by most
# non-AWS S3-compatible providers including MinIO; real AWS S3 also
# accepts it). Set to "false" only if a provider specifically requires
# virtual-hosted-style addressing.
DOCUMENT_S3_FORCE_PATH_STYLE="true"

# Gates POST /api/admin/seed (demo-data bootstrap) - deliberately its own
# secret, never AUTH_SECRET (Prompt 23 hardening: a worker/admin secret
# must never double as the session-signing secret). Refuses to run at all
# in production unless ALLOW_PRODUCTION_SEED=true is also explicitly set -
# see src/app/api/admin/seed/route.ts.
ADMIN_SEED_SECRET="replace-with-a-random-32-byte-secret"
ALLOW_PRODUCTION_SEED="false"

# ZATCA (Saudi VAT e-invoicing) - Fatoora integration, optional until you onboard.
ZATCA_ENVIRONMENT="sandbox"
ZATCA_API_BASE_URL="https://gw-fatoora.zatca.gov.sa/e-invoicing/developer-portal"
ZATCA_ONBOARDING_OTP=""
